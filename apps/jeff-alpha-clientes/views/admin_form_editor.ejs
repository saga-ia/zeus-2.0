<%- include('partials/header', { title: 'Editor do formulário · Alpha' }) %>
<style>
  .form-editor{max-width:900px;margin:0 auto}
  .editor-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:24px;flex-wrap:wrap}
  .editor-head h1{margin:0;font-size:24px;letter-spacing:-.02em}
  .editor-head p{margin:4px 0 0;color:var(--fg-3);font-size:13px}
  .editor-head .sticky-actions{display:flex;gap:8px}
  .ed-section{background:var(--bg-1);border:1px solid var(--line);border-radius:var(--radius);margin-bottom:14px;overflow:hidden}
  .ed-section-head{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--bg-2);border-bottom:1px solid var(--line)}
  .ed-section-head .num{font-family:ui-monospace,monospace;font-size:13px;color:var(--accent);min-width:24px}
  .ed-section-head input{margin:0;background:var(--bg-1);font-weight:600}
  .ed-section-head .grow{flex:1}
  .ed-section-body{padding:14px 16px}
  .ed-section-body .row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:8px}
  .ed-section-body .row label{margin:0 0 4px}
  .ed-questions{margin-top:12px;display:flex;flex-direction:column;gap:8px}
  .ed-q{background:var(--bg-2);border:1px solid var(--line);border-radius:var(--radius-sm);padding:12px}
  .ed-q-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}
  .ed-q-head .qnum{font-family:ui-monospace,monospace;font-size:12px;color:var(--fg-3);min-width:32px}
  .ed-q-head input.label-input{flex:1;font-weight:500}
  .ed-q-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;align-items:end}
  .ed-q-grid .full{grid-column:1/-1}
  .ed-q-grid label{margin:0 0 4px;font-size:11px}
  .ed-q-grid select,.ed-q-grid input{font-size:13px;padding:8px 10px}
  .icon-btn{background:transparent;border:1px solid var(--line);color:var(--fg-2);cursor:pointer;padding:6px 10px;border-radius:var(--radius-sm);font-size:13px;transition:all .15s}
  .icon-btn:hover{border-color:var(--accent);color:var(--accent)}
  .icon-btn.danger:hover{border-color:var(--danger);color:var(--danger)}
  .add-btn{background:transparent;border:1px dashed var(--line);color:var(--fg-3);padding:10px;border-radius:var(--radius-sm);width:100%;cursor:pointer;font-size:13px;transition:all .15s}
  .add-btn:hover{border-color:var(--accent);border-style:solid;color:var(--accent)}
  .checkbox-row{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--fg-2);cursor:pointer}
  .checkbox-row input{width:auto;margin:0}
  #saveBar{position:sticky;bottom:0;background:var(--bg);border-top:1px solid var(--line);padding:14px 0;margin-top:24px;display:flex;gap:12px;align-items:center;justify-content:flex-end;z-index:5}
  #saveStatus{font-size:13px;color:var(--fg-3)}
  #saveStatus.ok{color:var(--ok)}
  #saveStatus.err{color:var(--danger)}
  .preview-link{font-size:12px;color:var(--accent)}
  @media(max-width:760px){.ed-q-grid{grid-template-columns:1fr 1fr}.ed-section-body .row{grid-template-columns:1fr}}
</style>

<div class="form-editor">
  <div class="editor-head">
    <div>
      <h1>Editor do formulário de onboarding</h1>
      <p>Esse é o formulário que os clientes preenchem em <span class="preview-link"><a href="/onboarding" target="_blank" style="color:var(--accent)">cliente.jefersonhenrike.com/onboarding</a></span><% if (sheetUrl) { %> · <a href="<%= sheetUrl %>" target="_blank" style="color:var(--accent)">planilha de respostas</a><% } %></p>
    </div>
    <div class="sticky-actions">
      <a href="/onboarding" target="_blank" class="btn btn-sm">Pré-visualizar</a>
    </div>
  </div>

  <div id="sectionsRoot"></div>

  <button type="button" class="add-btn" id="addSectionBtn">+ Nova seção</button>

  <div id="saveBar">
    <span id="saveStatus"></span>
    <button type="button" class="btn" onclick="window.location.reload()">Descartar</button>
    <button type="button" class="btn btn-primary" id="saveBtn">Atualizar formulário</button>
  </div>
</div>

<script>
const QTYPES = [
  { v: 'text', l: 'Texto curto' },
  { v: 'textarea', l: 'Texto longo' },
  { v: 'email', l: 'E-mail' },
  { v: 'tel', l: 'Telefone' },
  { v: 'photo', l: 'Foto (upload)' },
];

let state = <%- JSON.stringify(sections.map(s => ({ tag: s.tag, title: s.title, subtitle: s.subtitle, questions: s.questions.map(q => ({ qkey: q.qkey, label: q.label, hint: q.hint || '', qtype: q.qtype, required: !!q.required, min_length: q.min_length || 0, big: !!q.big })) }))) %>;

function escapeHtml(s){
  return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function render() {
  const root = document.getElementById('sectionsRoot');
  root.innerHTML = '';
  state.forEach((sec, si) => {
    const secEl = document.createElement('div');
    secEl.className = 'ed-section';
    secEl.innerHTML = `
      <div class="ed-section-head">
        <span class="num">${si + 1}.</span>
        <input class="grow" data-bind="title" placeholder="Título da seção" value="${escapeHtml(sec.title)}">
        <button class="icon-btn" data-act="up" title="Subir">↑</button>
        <button class="icon-btn" data-act="down" title="Descer">↓</button>
        <button class="icon-btn danger" data-act="del-sec" title="Remover seção">Remover</button>
      </div>
      <div class="ed-section-body">
        <div class="row">
          <div><label>Tag (rótulo curto)</label><input data-bind="tag" placeholder="ex: Identificação" value="${escapeHtml(sec.tag)}"></div>
          <div><label>Subtítulo (opcional)</label><input data-bind="subtitle" placeholder="Texto auxiliar abaixo do título" value="${escapeHtml(sec.subtitle || '')}"></div>
        </div>
        <div class="ed-questions" data-questions></div>
        <button class="add-btn" data-act="add-q" style="margin-top:10px">+ Nova pergunta nesta seção</button>
      </div>`;

    const qWrap = secEl.querySelector('[data-questions]');
    sec.questions.forEach((q, qi) => qWrap.appendChild(renderQuestion(q, si, qi, sec.questions.length)));

    secEl.addEventListener('input', (ev) => {
      const t = ev.target;
      const bind = t.getAttribute('data-bind');
      if (bind && t.parentElement && t.parentElement.parentElement && t.parentElement.parentElement.classList.contains('ed-section-head')) {
        sec[bind] = t.value;
      } else if (bind && t.closest('.ed-section-body > .row')) {
        sec[bind] = t.value;
      }
    });

    secEl.addEventListener('click', (ev) => {
      const btn = ev.target.closest('button[data-act]');
      if (!btn) return;
      const act = btn.getAttribute('data-act');
      if (act === 'up' && si > 0) { state.splice(si-1, 0, state.splice(si,1)[0]); render(); }
      else if (act === 'down' && si < state.length - 1) { state.splice(si+1, 0, state.splice(si,1)[0]); render(); }
      else if (act === 'del-sec') { if (confirm('Remover esta seção e todas as perguntas dela?')) { state.splice(si,1); render(); } }
      else if (act === 'add-q') { sec.questions.push({ qkey: '', label: '', hint: '', qtype: 'text', required: false, min_length: 0, big: false }); render(); }
    });

    root.appendChild(secEl);
  });
}

function renderQuestion(q, si, qi, total) {
  const el = document.createElement('div');
  el.className = 'ed-q';
  const opts = QTYPES.map(t => `<option value="${t.v}"${t.v===q.qtype?' selected':''}>${t.l}</option>`).join('');
  el.innerHTML = `
    <div class="ed-q-head">
      <span class="qnum">${qi + 1}.</span>
      <input class="label-input" data-qbind="label" placeholder="Pergunta (ex: Qual o seu nome?)" value="${escapeHtml(q.label)}">
      <button class="icon-btn" data-qact="up" title="Subir">↑</button>
      <button class="icon-btn" data-qact="down" title="Descer">↓</button>
      <button class="icon-btn danger" data-qact="del" title="Remover">×</button>
    </div>
    <div class="ed-q-grid">
      <div><label>Tipo</label><select data-qbind="qtype">${opts}</select></div>
      <div><label>Chave (interno)</label><input data-qbind="qkey" placeholder="auto" value="${escapeHtml(q.qkey || '')}"></div>
      <div><label>Mínimo (caracteres)</label><input type="number" min="0" data-qbind="min_length" value="${q.min_length || 0}"></div>
      <div style="display:flex;flex-direction:column;gap:4px;justify-content:flex-end">
        <label class="checkbox-row"><input type="checkbox" data-qbind="required"${q.required?' checked':''}>Obrigatória</label>
        <label class="checkbox-row"><input type="checkbox" data-qbind="big"${q.big?' checked':''}>Campo grande</label>
      </div>
      <div class="full"><label>Dica/ajuda (opcional)</label><input data-qbind="hint" placeholder="Texto auxiliar abaixo da pergunta" value="${escapeHtml(q.hint || '')}"></div>
    </div>`;

  el.addEventListener('input', (ev) => {
    const t = ev.target;
    const b = t.getAttribute('data-qbind');
    if (!b) return;
    if (t.type === 'checkbox') q[b] = t.checked;
    else if (t.type === 'number') q[b] = parseInt(t.value || '0', 10) || 0;
    else q[b] = t.value;
  });

  el.addEventListener('click', (ev) => {
    const btn = ev.target.closest('button[data-qact]');
    if (!btn) return;
    const act = btn.getAttribute('data-qact');
    const arr = state[si].questions;
    if (act === 'up' && qi > 0) { arr.splice(qi-1, 0, arr.splice(qi,1)[0]); render(); }
    else if (act === 'down' && qi < total - 1) { arr.splice(qi+1, 0, arr.splice(qi,1)[0]); render(); }
    else if (act === 'del') { if (confirm('Remover esta pergunta?')) { arr.splice(qi,1); render(); } }
  });

  return el;
}

document.getElementById('addSectionBtn').addEventListener('click', () => {
  state.push({ tag: '', title: 'Nova seção', subtitle: '', questions: [] });
  render();
});

document.getElementById('saveBtn').addEventListener('click', async () => {
  const status = document.getElementById('saveStatus');
  const btn = document.getElementById('saveBtn');
  status.className = '';
  status.textContent = 'Salvando...';
  btn.disabled = true;

  for (const sec of state) {
    if (!String(sec.title || '').trim()) {
      status.className = 'err'; status.textContent = 'Toda seção precisa de um título.';
      btn.disabled = false; return;
    }
    for (const q of sec.questions) {
      if (!String(q.label || '').trim()) {
        status.className = 'err'; status.textContent = 'Toda pergunta precisa de um texto.';
        btn.disabled = false; return;
      }
    }
  }

  try {
    const r = await fetch('/api/admin/form/save', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sections: state })
    });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'erro');
    status.className = 'ok'; status.textContent = 'Formulário atualizado.';
    setTimeout(() => window.location.reload(), 800);
  } catch(e) {
    status.className = 'err'; status.textContent = 'Erro: ' + e.message;
    btn.disabled = false;
  }
});

render();
</script>
<%- include('partials/footer') %>
