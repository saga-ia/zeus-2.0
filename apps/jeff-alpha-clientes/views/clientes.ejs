<%- include('partials/header', { title: 'Clientes · Alpha' }) %>
<div class="page-head">
  <div>
    <h1>Clientes</h1>
    <p>Painel de gestao de clientes da Alpha Digital.</p>
  </div>
  <div class="actions">
    <a href="/leads" class="btn">Leads <% if (pendingLeads > 0) { %><span style="background:var(--accent);color:#000;border-radius:99px;padding:0 8px;font-size:11px;font-weight:700;margin-left:6px"><%= pendingLeads %></span><% } %></a>
    <button type="button" class="btn btn-primary" onclick="openModal('novoClienteModal')">+ Cadastrar novo cliente</button>
  </div>
</div>

<div class="modal-overlay" id="novoClienteModal" onclick="if(event.target===this)closeModal('novoClienteModal')">
  <div class="modal-box">
    <div class="modal-head">
      <h2>Cadastrar novo cliente</h2>
      <button type="button" onclick="closeModal('novoClienteModal')" class="modal-close">&#x2715;</button>
    </div>
    <form id="novoClienteForm">
      <label>Nome do cliente</label>
      <input type="text" id="ncNome" placeholder="Nome completo" autocomplete="off">
      <label>Telefone (WhatsApp)</label>
      <input type="tel" id="ncTelefone" placeholder="5511999999999" autocomplete="off">
      <label>E-mail (opcional)</label>
      <input type="email" id="ncEmail" placeholder="cliente@email.com" autocomplete="off">
      <div id="ncMsg" style="margin-top:12px;font-size:13px;display:none"></div>
      <div style="margin-top:20px">
        <button type="submit" class="btn btn-primary" style="width:100%">Cadastrar e provisionar subdomínio</button>
      </div>
    </form>
  </div>
</div>

<script>
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.getElementById('novoClienteForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  var nome = document.getElementById('ncNome').value.trim();
  var tel = document.getElementById('ncTelefone').value.replace(/\D/g,'');
  var email = document.getElementById('ncEmail').value.trim();
  var msg = document.getElementById('ncMsg');
  var btn = e.target.querySelector('button[type=submit]');
  if (!nome || tel.length < 10) {
    msg.style.display = 'block'; msg.style.color = 'var(--danger)';
    msg.textContent = 'Preencha nome e telefone com DDD.'; return;
  }
  btn.disabled = true; btn.textContent = 'Cadastrando...'; msg.style.display = 'none';
  try {
    var r = await fetch('/clientes/cadastrar-rapido', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: nome, phone: tel, email: email })
    });
    var data = await r.json();
    msg.style.display = 'block';
    if (data.ok) {
      msg.style.color = data.wa_error ? 'var(--danger)' : 'var(--ok)';
      msg.textContent = data.wa_error || 'Cliente cadastrado, subdomínio sendo criado, formulário enviado!';
      setTimeout(function(){ window.location.href = '/clientes/' + data.client_id; }, 1500);
    } else {
      msg.style.color = 'var(--danger)';
      msg.textContent = data.error || 'Erro ao cadastrar.';
      btn.disabled = false; btn.textContent = 'Cadastrar e enviar formulario';
    }
  } catch(err) {
    msg.style.display = 'block'; msg.style.color = 'var(--danger)';
    msg.textContent = 'Erro de conexao. Tente novamente.';
    btn.disabled = false; btn.textContent = 'Cadastrar e enviar formulario';
  }
});
function waLink(phone) {
  var p = String(phone || '').replace(/\D/g,'');
  if (!p) return '';
  if (p.length <= 11) p = '55' + p;
  return 'https://wa.me/' + p;
}
function initials(name) {
  return String(name||'?').trim().split(/\s+/).slice(0,2).map(function(s){return s[0]||'';}).join('').toUpperCase();
}
</script>

<div class="grid grid-3" style="margin-bottom:24px">
  <div class="kpi"><div class="kpi-label">Ativos</div><div class="kpi-value accent"><%= clients.filter(function(c){ return c.status === 'ativo'; }).length %></div></div>
  <div class="kpi"><div class="kpi-label">Pausados</div><div class="kpi-value"><%= clients.filter(function(c){ return c.status === 'pausado'; }).length %></div></div>
  <div class="kpi"><div class="kpi-label">Leads pendentes</div><div class="kpi-value"><%= pendingLeads %></div></div>
</div>

<% if (!clients.length) { %>
  <div class="card"><div class="empty">Nenhum cliente cadastrado ainda. Use o botão acima.</div></div>
<% } else { %>
  <div class="client-grid">
    <% clients.forEach(function(c) { %>
      <% var phone = String(c.contact_phone || '').replace(/\D/g,''); var waPhone = phone ? (phone.length <= 11 ? '55' + phone : phone) : ''; %>
      <% var cardHref = c.external_url ? c.external_url : '/clientes/' + c.id; var cardTarget = c.external_url ? ' target="_blank" rel="noopener"' : ''; %>
      <div class="client-card">
        <a href="<%= cardHref %>"<%- cardTarget %> class="client-card-main">
          <div class="client-avatar">
            <% if (c.has_photo && c.session_id) { %>
              <img src="/api/form/photo/<%= c.session_id %>" alt="<%= c.name %>" loading="lazy"/>
            <% } else { %>
              <span class="avatar-fallback"><%= (c.name||'?').trim().split(/\s+/).slice(0,2).map(function(s){return s[0]||'';}).join('').toUpperCase() %></span>
            <% } %>
          </div>
          <div class="client-info">
            <div class="client-name"><%= c.name %></div>
            <div class="client-phone"><%= c.contact_phone || 'sem telefone' %></div>
            <div class="client-tags">
              <span class="status-pill status-<%= c.status %>"><%= c.status %></span>
              <% if (c.onb_completed) { %>
                <span class="tag-onb done">onboarding ✓</span>
              <% } else if (c.session_id) { %>
                <span class="tag-onb pending">onboarding em andamento</span>
              <% } else { %>
                <span class="tag-onb empty">sem onboarding</span>
              <% } %>
            </div>
          </div>
        </a>
        <% if (waPhone) { %>
          <a class="wa-btn" href="https://wa.me/<%= waPhone %>" target="_blank" rel="noopener" title="Chamar no WhatsApp" onclick="event.stopPropagation()">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20.52 3.48A11.93 11.93 0 0 0 12.01 0C5.39 0 .03 5.36.03 11.97c0 2.11.55 4.17 1.6 5.99L0 24l6.21-1.63a11.97 11.97 0 0 0 5.8 1.48h.01c6.61 0 11.97-5.36 11.97-11.97 0-3.2-1.25-6.21-3.47-8.4ZM12.02 21.79h-.01a9.83 9.83 0 0 1-5.01-1.37l-.36-.21-3.69.97.99-3.6-.23-.37a9.85 9.85 0 0 1-1.51-5.24c0-5.45 4.43-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.43 9.81-9.99 9.81Zm5.43-7.36c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.11 3.21 5.11 4.5.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z"/></svg>
            WhatsApp
          </a>
        <% } %>
      </div>
    <% }); %>
  </div>
<% } %>
<%- include('partials/footer') %>
