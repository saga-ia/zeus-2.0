<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Configurar 2FA · Alpha Clientes</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body class="auth">
<% if (typeof flash !== 'undefined' && flash) { %><div class="flash flash-<%= flash.type %>" style="position:fixed;top:14px;left:50%;transform:translateX(-50%);max-width:400px;width:calc(100% - 28px);z-index:5"><%= flash.message %></div><% } %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand"><span class="dot"></span> ALPHA · Clientes</div>
    <h1>Ative o 2FA</h1>
    <p class="lead">Escaneie o QR no seu app autenticador e digite o código pra confirmar.</p>
    <img src="<%= qr %>" class="qr" alt="QR Code 2FA">
    <div class="secret"><%= secret %></div>
    <form method="post" action="/login/totp/setup">
      <label>Código de 6 dígitos</label>
      <input type="text" name="code" inputmode="numeric" pattern="[0-9]*" maxlength="6" required autofocus>
      <div style="margin-top:20px"><button type="submit" class="btn btn-primary" style="width:100%">Ativar 2FA</button></div>
    </form>
  </div>
</div>
</body>
</html>
