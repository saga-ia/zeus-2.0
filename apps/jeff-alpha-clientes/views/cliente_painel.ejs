<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= client.name %> · Painel</title>
<link rel="stylesheet" href="/static/painel.css">
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <div class="side-brand">
      <div class="brand">
        <% var inits = (client.name||'?').trim().split(/\s+/).slice(0,2).map(function(s){return s[0]||'';}).join('').toUpperCase(); %>
        <%= inits %>
      </div>
      <div class="brand-meta">
        <h1><%= client.name %></h1>
        <p class="sub">Painel personalizado</p>
      </div>
    </div>

    <div class="side-search">
      <div class="search-box">
        <input id="search-input" type="text" placeholder="Buscar..." autocomplete="off">
        <button id="search-clear" class="search-clear" type="button" hidden>&times;</button>
      </div>
      <div id="search-results" class="search-results" hidden></div>
    </div>

    <nav id="tabs" class="side-tabs"></nav>

    <div class="side-foot">
      <div class="user-mini">
        <span><%= cuser.name || cuser.email %></span>
        <form method="post" action="/logout" style="margin:0"><button class="logout-btn">Sair</button></form>
      </div>
      <div class="legend">
        <span class="lg"><span class="d tab"></span>Aba</span>
        <span class="lg"><span class="d highlight"></span>Destaque</span>
        <span class="lg"><span class="d question"></span>Pergunta</span>
      </div>
    </div>
  </aside>

  <main id="content"></main>
</div>

<div id="popup" class="popup hidden"></div>

<script>
window.__INITIAL__ = {
  blocks: <%- JSON.stringify(blocks || []) %>,
  state: <%- JSON.stringify(state || { answers: {}, actions: {} }) %>,
  client_name: <%- JSON.stringify(client.name) %>,
};
</script>
<script src="/static/painel.js"></script>
</body>
</html>
