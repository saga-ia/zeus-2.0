function fmtTime(ts) {
  if (!ts) return '';
  const d = new Date(ts * 1000);
  const now = new Date();
  const sameDay = d.toDateString() === now.toDateString();
  return sameDay ? d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : d.toLocaleDateString('pt-BR');
}

async function loadConversations() {
  const slot = $('#conv-filter').value;
  const path = '/conversations' + (slot ? '?slot=' + slot : '');
  const { conversations } = await api('GET', path);
  const list = $('#conv-items');
  if (!conversations.length) {
    list.innerHTML = '<div class="empty-state"><h3>Sem conversas ainda</h3><div>Conecte um SDR e receba mensagens.</div></div>';
    return;
  }
  list.innerHTML = conversations.map(c => `
    <div class="conv-item ${currentChat && currentChat.slot === c.slot && currentChat.chat_id === c.chat_id ? 'active' : ''}"
         onclick="openChat(${c.slot}, '${c.chat_id.replace(/'/g, "\\'")}', '${(c.contact_name || c.contact_phone || '').replace(/'/g, "\\'")}')">
      <div class="conv-row1">
        <div class="conv-name">${c.contact_name || '+' + (c.contact_phone || '?')}</div>
        <div class="conv-time">${fmtTime(c.last_ts)}</div>
      </div>
      <div class="conv-preview">${c.last_from_me ? '➜ ' : ''}${(c.last_message || '').slice(0, 50)}</div>
      <div class="conv-row1">
        <div class="conv-sdr">${c.sdr_name || 'Slot ' + c.slot}</div>
        ${c.unread > 0 ? '<div class="unread-dot"></div>' : ''}
      </div>
    </div>
  `).join('');
}

async function openChat(slot, chatId, title) {
  currentChat = { slot, chat_id: chatId, title };
  const pane = $('#conv-pane');
  pane.innerHTML = `
    <div class="conv-pane-header">
      <div>
        <div style="font-weight:700">${title || chatId}</div>
        <div style="font-size:11px;color:var(--subtext)">SDR: ${(sdrsCache.find(s=>s.slot===slot)||{}).name || 'Slot ' + slot}</div>
      </div>
      <button class="btn btn-ghost btn-sm" onclick="loadMessages()">↻</button>
    </div>
    <div class="conv-pane-body" id="msg-body"></div>
    <div class="conv-pane-input">
      <textarea id="reply-body" placeholder="Escreva uma resposta…"></textarea>
      <button class="btn btn-primary" onclick="sendReply()">Enviar</button>
    </div>
  `;
  await api('POST', '/conversations/mark-read', { slot, chat_id: chatId });
  await loadMessages();
  loadConversations();
}

async function loadMessages() {
  if (!currentChat) return;
  const { messages } = await api('GET', `/conversations/messages?slot=${currentChat.slot}&chat_id=${encodeURIComponent(currentChat.chat_id)}`);
  const body = $('#msg-body');
  if (!body) return;
  body.innerHTML = messages.map(m => `
    <div class="msg-bubble ${m.from_me ? 'msg-me' : 'msg-them'}">
      ${(m.body || '').replace(/</g,'&lt;').replace(/\n/g,'<br>')}
      <div class="msg-meta">${fmtTime(m.ts)}</div>
    </div>
  `).join('');
  body.scrollTop = body.scrollHeight;
}

async function sendReply() {
  const body = $('#reply-body').value.trim();
  if (!body || !currentChat) return;
  try {
    await api('POST', '/conversations/reply', { slot: currentChat.slot, chat_id: currentChat.chat_id, body });
    $('#reply-body').value = '';
    setTimeout(loadMessages, 800);
  } catch (e) {
    alert('Erro ao enviar: ' + e.message);
  }
}

async function loadMaturation() {
  const { config, statuses } = await api('GET', '/maturation/config');
  $('#mat-enabled').classList.toggle('on', !!config.enabled);
  $('#mat-min-turns').value = config.min_turns;
  $('#mat-max-turns').value = config.max_turns;
  $('#mat-min-delay').value = config.min_delay_seconds;
  $('#mat-max-delay').value = config.max_delay_seconds;
  $('#mat-daily-max').value = config.daily_max_sessions;

  const statusMap = {};
  statuses.forEach(s => statusMap[s.slot] = s);
  const slotsDiv = $('#mat-slots');
  const eligible = sdrsCache.filter(s => s.status === 'ready');
  if (!eligible.length) {
    slotsDiv.innerHTML = '<div class="empty-state" style="padding:20px"><h3>Sem chips conectados</h3><div>Conecte pelo menos 2 chips na aba Cadastrar SDR.</div></div>';
  } else {
    slotsDiv.innerHTML = eligible.map(s => {
      const st = statusMap[s.slot] || {};
      return `
        <div class="switch-row">
          <div>
            <div style="font-weight:700">${s.name || 'Slot ' + s.slot}</div>
            <div style="font-size:11px;color:var(--subtext)">+${s.phone} · hoje: ${st.sessions_today || 0}</div>
          </div>
          <div class="switch ${st.enabled ? 'on' : ''}" onclick="toggleMatSlot(${s.slot}, ${st.enabled ? 0 : 1})"></div>
        </div>
      `;
    }).join('');
  }

  const { log } = await api('GET', '/maturation/log');
  $('#mat-log').innerHTML = log.length
    ? log.map(l => `<div class="log-item"><span class="log-slot">Slot ${l.from_slot} → ${l.to_slot}</span> · ${l.body} <span style="float:right">${l.ts.slice(11,16)}</span></div>`).join('')
    : '<div class="empty-state" style="padding:20px">Ainda sem histórico.</div>';
}

