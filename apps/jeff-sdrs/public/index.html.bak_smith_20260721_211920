<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SDRs — Jeff</title>
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>
<style>
  :root {
    --bg: #0b0d13;
    --panel: #14171f;
    --panel-2: #1b1f2a;
    --border: #262b38;
    --accent: #d4a24a;
    --accent-2: #f3c467;
    --green: #22c55e;
    --yellow: #eab308;
    --red: #ef4444;
    --blue: #4f8ef7;
    --text: #e8eaf0;
    --subtext: #8b94a7;
    --sidebar-w: 240px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', -apple-system, 'Segoe UI', system-ui, sans-serif;
    font-size: 14px;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  button, input, textarea, select { font-family: inherit; font-size: inherit; color: inherit; }
  input, textarea, select {
    width: 100%; background: var(--bg); border: 1px solid var(--border); border-radius: 10px;
    padding: 10px 12px; outline: none; transition: border .15s;
  }
  input:focus, textarea:focus, select:focus { border-color: var(--accent); }
  label { display: block; font-size: 11px; color: var(--subtext); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .5px; font-weight: 600; }

  .btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 10px 16px; border-radius: 10px; border: none;
    cursor: pointer; font-size: 13px; font-weight: 600; transition: all .15s; background: transparent; color: var(--text);
  }
  .btn:hover { opacity: .88; }
  .btn:disabled { opacity: .4; cursor: default; }
  .btn-primary { background: var(--accent); color: #17140a; }
  .btn-primary:hover { background: var(--accent-2); }
  .btn-ghost { border: 1px solid var(--border); }
  .btn-ghost:hover { background: var(--panel-2); }
  .btn-danger { background: var(--red); color: #fff; }
  .btn-success { background: var(--green); color: #04180b; }
  .btn-success:hover { background: #16a34a; color: #fff; }
  .btn-sm { padding: 6px 12px; font-size: 12px; }
  .btn-full { width: 100%; justify-content: center; }

  /* Login */
  #login-screen { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }
  .login-card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 16px; padding: 40px;
    width: 380px; box-shadow: 0 20px 60px #00000060;
  }
  .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; }
  .brand-mark {
    width: 40px; height: 40px; border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: grid; place-items: center; font-weight: 800; color: #17140a; font-size: 18px;
  }
  .brand-text { font-weight: 800; font-size: 17px; letter-spacing: -.2px; }
  .brand-text small { display: block; font-size: 11px; color: var(--subtext); font-weight: 500; letter-spacing: 0; }
  .form-group { margin-bottom: 14px; }
  .error-msg { color: var(--red); font-size: 12px; margin-top: 10px; min-height: 18px; }

  /* App shell with sidebar */
  #app-screen { display: none; min-height: 100vh; }
  .layout { display: grid; grid-template-columns: var(--sidebar-w) 1fr; min-height: 100vh; }
  aside {
    background: #0a0c11; border-right: 1px solid var(--border);
    display: flex; flex-direction: column; padding: 20px 14px; gap: 4px; position: sticky; top: 0; height: 100vh;
  }
  aside .brand { margin-bottom: 28px; padding-left: 6px; }
  .side-item {
    display: flex; align-items: center; gap: 12px; padding: 11px 14px; border-radius: 10px;
    cursor: pointer; color: var(--subtext); font-weight: 600; font-size: 14px; transition: all .15s;
  }
  .side-item:hover { color: var(--text); background: var(--panel-2); }
  .side-item.active { background: var(--panel-2); color: var(--accent); }
  .side-item .ico { width: 20px; height: 20px; display: grid; place-items: center; opacity: .9; }
  aside .spacer { flex: 1; }
  .side-user { padding: 12px 14px; border-top: 1px solid var(--border); margin-top: 8px; color: var(--subtext); font-size: 12px; }
  .side-user b { color: var(--text); display: block; font-size: 13px; margin-bottom: 2px; }
  .side-logout { margin-top: 8px; font-size: 12px; color: var(--subtext); cursor: pointer; }
  .side-logout:hover { color: var(--red); }

  main { padding: 32px 40px 60px; max-width: 1400px; width: 100%; }
  .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
  .page-header h1 { font-size: 22px; font-weight: 800; letter-spacing: -.3px; }
  .page-header p { color: var(--subtext); font-size: 13px; margin-top: 4px; }

  /* Cards */
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; padding: 20px; }
  .card + .card { margin-top: 16px; }
  .card-title { font-size: 14px; font-weight: 700; margin-bottom: 14px; }

  /* Badge */
  .badge { display: inline-block; padding: 3px 9px; border-radius: 999px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; }
  .badge-idle { background: #2a2f3d; color: var(--subtext); }
  .badge-connecting { background: #4a3410; color: #fbd08a; }
  .badge-qr { background: #17385d; color: #8fbfff; }
  .badge-ready { background: #0f3a24; color: #7ee7a4; }
  .badge-disconnected { background: #421414; color: #fca5a5; }

  /* SDR grid */
  .sdr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .sdr-card {
    background: var(--panel-2); border: 1px solid var(--border); border-radius: 12px; padding: 16px;
    display: flex; flex-direction: column; gap: 10px; min-height: 180px; transition: border .15s;
  }
  .sdr-card.status-ready { border-color: #1f5a3a; }
  .sdr-card.status-qr { border-color: #234a7a; }
  .sdr-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .toggle-active { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; user-select: none; }
  .toggle-active .sw { position: relative; width: 36px; height: 20px; background: #3a2a2a; border-radius: 999px; transition: background .15s; border: 1px solid #4a1c1c; }
  .toggle-active .sw::after { content: ''; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; background: #d95555; border-radius: 50%; transition: transform .15s, background .15s; }
  .toggle-active.on .sw { background: #0f3a24; border-color: #1f5a3a; }
  .toggle-active.on .sw::after { transform: translateX(16px); background: #7ee7a4; }
  .toggle-active .lbl { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #fca5a5; }
  .toggle-active.on .lbl { color: #7ee7a4; }
  .sdr-slot { font-weight: 800; font-size: 12px; color: var(--subtext); }
  .sdr-name-row { display: flex; flex-direction: column; gap: 2px; margin-top: 2px; }
  .sdr-name-row input { font-size: 14px; font-weight: 700; padding: 6px 10px; background: var(--bg); }
  .sdr-name-row input.role { font-size: 12px; color: var(--subtext); font-weight: 500; }
  .sdr-phone { font-size: 11px; color: var(--subtext); font-family: 'JetBrains Mono', monospace; }
  .sdr-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: auto; }
  .qr-box { background: #fff; padding: 10px; border-radius: 10px; display: grid; place-items: center; }
  .qr-hint { font-size: 11px; color: var(--subtext); text-align: center; margin-top: 6px; }

  /* Conversations */
  .conv-layout { display: grid; grid-template-columns: 340px 1fr; gap: 16px; height: calc(100vh - 180px); min-height: 500px; }
  .conv-list { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
  .conv-list-header { padding: 14px 16px; border-bottom: 1px solid var(--border); display: flex; gap: 8px; align-items: center; }
  .conv-list-header select { padding: 6px 10px; font-size: 12px; }
  .conv-items { flex: 1; overflow-y: auto; }
  .conv-item {
    padding: 12px 16px; border-bottom: 1px solid var(--border); cursor: pointer; transition: background .1s;
    display: flex; flex-direction: column; gap: 4px;
  }
  .conv-item:hover { background: var(--panel-2); }
  .conv-item.active { background: var(--panel-2); border-left: 3px solid var(--accent); padding-left: 13px; }
  .conv-row1 { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .conv-name { font-weight: 700; font-size: 13px; }
  .conv-time { font-size: 10px; color: var(--subtext); }
  .conv-preview { font-size: 12px; color: var(--subtext); white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
  .conv-sdr { font-size: 10px; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .3px; }
  .unread-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }

  .conv-pane { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
  .conv-pane-header { padding: 14px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
  .conv-pane-body { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .msg-bubble {
    max-width: 65%; padding: 9px 13px; border-radius: 12px; font-size: 13px; line-height: 1.4; word-wrap: break-word;
  }
  .msg-them { background: var(--panel-2); align-self: flex-start; border-bottom-left-radius: 3px; }
  .msg-me { background: linear-gradient(135deg, #4a3610, #7a5820); color: #f7e6c2; align-self: flex-end; border-bottom-right-radius: 3px; }
  .msg-meta { font-size: 10px; color: var(--subtext); margin-top: 3px; }
  .conv-pane-input { padding: 14px 16px; border-top: 1px solid var(--border); display: flex; gap: 8px; }
  .conv-pane-input textarea { resize: none; height: 44px; padding: 12px 14px; }
  .conv-empty { flex: 1; display: grid; place-items: center; color: var(--subtext); font-size: 13px; }

  /* Maturation */
  .maturation-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; }
  @media (max-width: 900px) { .maturation-grid { grid-template-columns: 1fr; } }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
  .switch-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; background: var(--panel-2); border-radius: 10px; margin-bottom: 8px; }
  .switch {
    position: relative; width: 40px; height: 22px; background: var(--border); border-radius: 999px;
    cursor: pointer; transition: background .15s;
  }
  .switch.on { background: var(--accent); }
  .switch::after {
    content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%;
    background: #fff; transition: transform .15s;
  }
  .switch.on::after { transform: translateX(18px); }

  .log-list { font-size: 12px; color: var(--subtext); max-height: 400px; overflow-y: auto; }
  .log-item { padding: 8px 0; border-bottom: 1px solid var(--border); }
  .log-item:last-child { border: none; }
  .log-slot { color: var(--accent); font-weight: 700; }

  /* Modal */
  .modal-overlay { position: fixed; inset: 0; background: #000000cc; display: flex; align-items: center; justify-content: center; z-index: 100; padding: 20px; backdrop-filter: blur(4px); }
  .modal { background: var(--panel); border: 1px solid var(--border); border-radius: 16px; width: 100%; max-width: 520px; padding: 28px; max-height: 90vh; overflow-y: auto; box-shadow: 0 30px 80px #00000080; }
  .modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
  .modal-title { font-weight: 800; font-size: 18px; }
  .modal-close { background: transparent; border: none; color: var(--subtext); font-size: 20px; cursor: pointer; padding: 4px 8px; line-height: 1; border-radius: 8px; }
  .modal-close:hover { background: var(--panel-2); color: var(--text); }
  .modal-sub { color: var(--subtext); font-size: 13px; margin-bottom: 20px; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }

  /* Tabs */
  .tabs { display: flex; gap: 4px; background: var(--panel-2); padding: 4px; border-radius: 10px; margin-bottom: 20px; }
  .tab { flex: 1; padding: 9px 14px; text-align: center; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--subtext); transition: all .15s; }
  .tab:hover { color: var(--text); }
  .tab.active { background: var(--panel); color: var(--accent); box-shadow: 0 2px 8px #00000040; }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  .qr-canvas-wrap { background: #fff; padding: 16px; border-radius: 12px; display: grid; place-items: center; margin: 0 auto 12px; width: fit-content; }
  .qr-canvas-wrap canvas { display: block; }
  .qr-steps { font-size: 12px; color: var(--subtext); line-height: 1.7; padding: 12px 14px; background: var(--panel-2); border-radius: 10px; }
  .qr-steps b { color: var(--text); }

  .pair-code-box {
    text-align: center; padding: 20px; background: linear-gradient(135deg, #1a1e2b, #14171f);
    border: 1px solid var(--accent); border-radius: 12px; margin: 16px 0;
    font-family: 'JetBrains Mono', 'Courier New', monospace; font-size: 32px; font-weight: 800;
    color: var(--accent-2); letter-spacing: 8px;
  }
  .pair-code-loading { text-align: center; padding: 30px; color: var(--subtext); font-size: 13px; }

  .instructions-textarea { min-height: 300px; resize: vertical; font-family: 'JetBrains Mono', 'Courier New', monospace; font-size: 13px; line-height: 1.6; }
  .instructions-meta { font-size: 11px; color: var(--subtext); margin-top: 8px; }

  .chip-row { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; margin-bottom: 6px; min-height: 32px; }
  .chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
    background: var(--panel-2); border: 1px solid var(--border); border-radius: 999px;
    font-size: 12px; font-weight: 600;
  }
  .chip .rm { cursor: pointer; color: var(--subtext); font-weight: 700; }
  .chip .rm:hover { color: var(--red); }
  .chip-input-row { display: flex; gap: 6px; }
  .chip-input-row input { flex: 1; }
  .config-hint { font-size: 11px; color: var(--subtext); margin-top: 4px; line-height: 1.5; }
  .upload-summary { display: flex; gap: 14px; margin: 10px 0 6px; font-size: 12px; color: var(--subtext); }
  .upload-summary b { color: var(--text); font-size: 14px; display: block; }
  .upload-jobs-list { max-height: 220px; overflow-y: auto; font-size: 12px; }
  .upload-job-item { padding: 6px 0; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; gap: 8px; }
  .upload-job-item:last-child { border: none; }
  .st-pill { padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
  .st-pill.pending { background: #2a2f3d; color: var(--subtext); }
  .st-pill.sent { background: #0f3a24; color: #7ee7a4; }
  .st-pill.error { background: #421414; color: #fca5a5; }
  .select-mode { display: flex; gap: 6px; background: var(--panel-2); padding: 4px; border-radius: 8px; }
  .select-mode > div { flex: 1; text-align: center; padding: 8px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600; color: var(--subtext); }
  .select-mode > div.on { background: var(--accent); color: #17140a; }

  .sdr-card .btn-full-w { flex: 1; }
  .sdr-actions-row { display: flex; gap: 6px; }

  .empty-state { padding: 60px 20px; text-align: center; color: var(--subtext); }
  .empty-state h3 { color: var(--text); margin-bottom: 8px; font-size: 16px; }

  @media (max-width: 720px) {
    aside { position: fixed; z-index: 10; transform: translateX(-100%); transition: transform .2s; }
    aside.open { transform: translateX(0); }
    .layout { grid-template-columns: 1fr; }
    main { padding: 20px 16px 40px; }
    .conv-layout { grid-template-columns: 1fr; height: auto; }
  }
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login-screen">
  <div class="login-card">
    <div class="brand">
      <div class="brand-mark">S</div>
      <div class="brand-text">SDRs<small>Pré-atendimento Jeff</small></div>
    </div>
    <div class="form-group">
      <label>Usuário</label>
      <input id="login-user" type="text" autocomplete="username" value="jeff" />
    </div>
    <div class="form-group">
      <label>Senha</label>
      <input id="login-pass" type="password" autocomplete="current-password" />
    </div>
    <button class="btn btn-primary btn-full" onclick="doLogin()">Entrar</button>
    <div id="login-error" class="error-msg"></div>
    <div style="text-align:center;margin-top:14px;">
      <a href="#" id="forgot-link" onclick="doForgot();return false;" style="color:#94a3b8;font-size:13px;text-decoration:none;">Esqueci a senha</a>
    </div>
    <div id="forgot-msg" style="text-align:center;margin-top:10px;font-size:13px;color:#22c55e;"></div>
  </div>
</div>

<!-- APP -->
<div id="app-screen">
  <div class="layout">
    <aside>
      <div class="brand">
        <div class="brand-mark">S</div>
        <div class="brand-text">SDRs<small>Pré-atendimento</small></div>
      </div>
      <div class="side-item active" data-view="sdrs" onclick="showView('sdrs')">
        <span class="ico">👥</span> Cadastrar SDR
      </div>
      <div class="side-item" data-view="conversations" onclick="showView('conversations')">
        <span class="ico">💬</span> Acompanhar Conversas
      </div>
      <div class="side-item" data-view="maturation" onclick="showView('maturation')">
        <span class="ico">🌱</span> Maturar Chips
      </div>
      <div class="side-item" onclick="window.open('/api/auth/crm-sso','_blank')">
        <span class="ico">📇</span> CRM
      </div>
      <div class="side-item" onclick="window.open('/api/auth/crm-sso?target=/tags','_blank')">
        <span class="ico">🏷️</span> Tags
      </div>
      <div class="side-item" id="side-system" style="display:none" onclick="openSystemModal()">
        <span class="ico">⚙️</span> Configurações do Sistema
      </div>
      <div class="spacer"></div>
      <div class="side-user">
        <b id="user-name">—</b>
        <div id="user-role">admin</div>
        <div class="side-logout" onclick="doLogout()">Sair</div>
      </div>
    </aside>
    <main>
      <div id="view-sdrs" class="view">
        <div class="page-header">
          <div>
            <h1>Cadastrar SDR</h1>
            <p>Conecte um chip WhatsApp por SDR e coloque o nome. Cada slot vira um agente de pré-atendimento.</p>
          </div>
          <button class="btn btn-ghost" onclick="loadSdrs()">↻ Atualizar</button>
        </div>
        <div class="card">
          <div class="sdr-grid" id="sdr-grid"></div>
        </div>
      </div>

      <div id="view-conversations" class="view" style="display:none">
        <div class="page-header">
          <div>
            <h1>Acompanhar Conversas</h1>
            <p>Todas as conversas que os SDRs estão tendo. Clique numa pra ver o histórico e responder.</p>
          </div>
          <button class="btn btn-ghost" onclick="loadConversations()">↻ Atualizar</button>
        </div>
        <div class="conv-layout">
          <div class="conv-list">
            <div class="conv-list-header">
              <select id="conv-filter" onchange="loadConversations()">
                <option value="">Todos os SDRs</option>
              </select>
            </div>
            <div class="conv-items" id="conv-items">
              <div class="empty-state"><h3>Carregando…</h3></div>
            </div>
          </div>
          <div class="conv-pane" id="conv-pane">
            <div class="conv-empty">Selecione uma conversa</div>
          </div>
        </div>
      </div>

      <div id="view-maturation" class="view" style="display:none">
        <div class="page-header">
          <div>
            <h1>Maturar Chips</h1>
            <p>Aquecimento entre chips conectados. Envia mensagens casuais entre eles pra amadurecer o número.</p>
          </div>
        </div>
        <div class="maturation-grid">
          <div>
            <div class="card">
              <div class="card-title">Configuração</div>
              <div class="switch-row">
                <div>
                  <div style="font-weight:700">Aquecimento ativo</div>
                  <div style="font-size:12px;color:var(--subtext)">Roda em loop, respeitando limites por chip</div>
                </div>
                <div class="switch" id="mat-enabled" onclick="toggleMatEnabled()"></div>
              </div>
              <div class="form-row">
                <div><label>Turnos mín</label><input id="mat-min-turns" type="number" min="1" /></div>
                <div><label>Turnos máx</label><input id="mat-max-turns" type="number" min="1" /></div>
              </div>
              <div class="form-row">
                <div><label>Delay mín (s)</label><input id="mat-min-delay" type="number" min="10" /></div>
                <div><label>Delay máx (s)</label><input id="mat-max-delay" type="number" min="10" /></div>
              </div>
              <div class="form-group">
                <label>Máx sessões por chip/dia</label>
                <input id="mat-daily-max" type="number" min="1" />
              </div>
              <button class="btn btn-primary btn-full" onclick="saveMatConfig()">Salvar configuração</button>
            </div>
            <div class="card">
              <div class="card-title">Chips habilitados</div>
              <div id="mat-slots"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-title">Histórico recente</div>
            <div class="log-list" id="mat-log"></div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- MODAL: Ativar SDR (escolha Zeus / outro número) -->
<div id="modal-activate" class="modal-overlay" style="display:none">
  <div class="modal" style="max-width:520px">
    <div class="modal-header">
      <div>
        <div class="modal-title">Ativar SDR <span id="activate-slot-label" style="color:var(--subtext);font-weight:500"></span></div>
        <div class="modal-sub">Escolha quem vai atender por esse SDR.</div>
      </div>
      <button class="modal-close" onclick="closeActivateModal()">×</button>
    </div>
    <div style="display:grid;gap:12px;margin-top:6px">
      <button class="btn btn-primary btn-full" style="padding:16px;text-align:left" onclick="chooseActivateZeus()">
