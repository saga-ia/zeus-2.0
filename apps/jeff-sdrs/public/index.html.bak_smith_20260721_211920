async function saveConfig() {
  if (currentCfgSlot == null) return;
  try {
    // se sobrou lista colada sem clicar em Salvar lista, salva agora antes de fechar
    const pendingText = ($('#cfg-list-input').value || '').trim();
    if (pendingText) {
      const pending = parseContactList(pendingText);
      if (pending.length && confirm(`Salvar também ${pending.length} contato(s) que estão na caixa de lista?`)) {
        try {
          await api('POST', '/sdrs/' + currentCfgSlot + '/upload-contacts', { contacts: pending });
          $('#cfg-list-input').value = '';
        } catch (e) { alert('Aviso: erro ao salvar lista pendente: ' + e.message); }
      }
    }
    const master = $('#cfg-master-slot').value;
    await api('PUT', '/sdrs/' + currentCfgSlot + '/config', {
      welcome_message: $('#cfg-welcome').value,
      triggers: cfgTriggers,
      trigger_mode: cfgTriggerMode,
      master_slot: master === '' ? null : parseInt(master, 10),
      ai_active: (sdrsCache.find(x => x.slot === currentCfgSlot) || {}).ai_active ? 1 : 0,
      sdr_mode: cfgSdrMode,
      personality_level: parseInt($('#cfg-personality').value, 10),
      reference_url: $('#cfg-reference-url').value.trim() || null,
      conversation_instructions: $('#cfg-conversation-instructions').value,
      instructions: $('#cfg-init-instructions').value,
      dispatch_min_delay: parseInt($('#cfg-dispatch-min').value, 10),
      dispatch_max_delay: parseInt($('#cfg-dispatch-max').value, 10),
      dispatch_pause_every: parseInt($('#cfg-pause-every').value, 10),
      dispatch_pause_seconds: parseInt($('#cfg-pause-secs').value, 10),
      dispatch_messages: cfgDispatchMessages.map(body => ({ body })).filter(m => m.body && m.body.trim()),
      ai_key_id: document.getElementById('cfg-ai-key').value || null,
      ai_provider: document.getElementById('cfg-ai-provider').value || null,
      ai_model: document.getElementById('cfg-ai-model').value || null,
      ai_daily_limit: parseInt(document.getElementById('cfg-ai-daily-limit').value, 10),
      send_link_enabled: document.getElementById('cfg-send-link-enabled').checked ? 1 : 0,
      send_link_url: document.getElementById('cfg-send-link-url').value.trim() || null,
      send_link_trigger: document.getElementById('cfg-send-link-trigger').value.trim() || null,
      send_file_enabled: document.getElementById('cfg-send-file-enabled').checked ? 1 : 0,
      send_file_trigger: document.getElementById('cfg-send-file-trigger').value.trim() || null,
      send_image_enabled: document.getElementById('cfg-send-image-enabled').checked ? 1 : 0,
      send_image_trigger: document.getElementById('cfg-send-image-trigger').value.trim() || null,
    });
    closeConfigModal();
    loadSdrs();
  } catch (e) {
    alert('Erro ao salvar: ' + e.message);
  }
}

function parseContactList(text) {
  return text.split(/\r?\n/).map(line => {
    const t = line.trim();
    if (!t) return null;
    const parts = t.split(/[,;\t|]/).map(x => x.trim().replace(/^"|"$/g, '')).filter(Boolean);
    if (!parts.length) return null;
    let phone = '', name = null;
    for (const p of parts) {
      const digits = p.replace(/\D/g, '');
      if (!phone && digits.length >= 10) { phone = digits; }
      else if (!name && p.replace(/\d/g, '').trim().length > 1) { name = p; }
    }
    if (!phone && parts.length === 1) {
      const digits = parts[0].replace(/\D/g, '');
      if (digits.length >= 10) phone = digits;
    }
    if (!phone || phone.length < 12) return null;
    return { phone, name };
  }).filter(Boolean);
}

function onManualEnter(fromField) {
  const phoneEl = $('#cfg-manual-phone');
  const nameEl = $('#cfg-manual-name');
  const rawPhone = (phoneEl.value || '').replace(/\D/g, '');
  // Se o usuario apertou Enter no campo Nome mas o telefone ainda esta vazio,
  // NAO submete: apenas move foco pro telefone. Evita mensagem de erro confusa
  // quando ele digitou o nome primeiro esperando pular pro proximo campo.
  if (fromField === 'name' && (!rawPhone || rawPhone.length < 12)) {
    phoneEl.focus();
    return;
  }
  addManualContact();
}

async function addManualContact() {
  if (currentCfgSlot == null) return;
  const phoneEl = $('#cfg-manual-phone');
  const nameEl = $('#cfg-manual-name');
  const rawPhone = (phoneEl.value || '').replace(/\D/g, '');
  const nm = (nameEl.value || '').trim();
  if (!rawPhone) {
    alert('Preencha o numero (DDI+DDD+numero, ex: 5511999998888).');
    phoneEl.focus();
    return;
  }
  if (rawPhone.length < 12) {
    alert('Numero curto. Precisa ter DDI+DDD+numero, so digitos (ex: 5511999998888).');
    phoneEl.focus();
    return;
  }
  try {
    const r = await api('POST', '/sdrs/' + currentCfgSlot + '/upload-contacts', { contacts: [{ phone: rawPhone, name: nm || null }] });
    if (r && r.duplicated && !r.added) {
      alert('Numero ja esta na fila ou ja foi enviado. Nao adicionado de novo.');
    }
    phoneEl.value = '';
    nameEl.value = '';
    phoneEl.focus();
    refreshUploadJobs();
  } catch (e) {
    alert('Erro ao salvar contato: ' + e.message);
  }
}

function clearListInput() {
  $('#cfg-list-input').value = '';
}

async function submitContactList() {
  if (currentCfgSlot == null) return;
  const text = $('#cfg-list-input').value;
  const contacts = parseContactList(text);
  if (!contacts.length) { alert('Nenhum contato válido detectado. Um número por linha, opcional: número,nome'); return; }
  if (!confirm(`Salvar ${contacts.length} contato(s) na lista deste SDR?`)) return;
  try {
    const res = await api('POST', '/sdrs/' + currentCfgSlot + '/upload-contacts', { contacts });
    $('#cfg-list-input').value = '';
    const dupPart = res.duplicated ? ` Duplicados ignorados: ${res.duplicated}.` : '';
    alert(`Salvos: ${res.added}. Ignorados: ${res.skipped}.${dupPart}`);
    refreshUploadJobs();
  } catch (e) {
    alert('Erro: ' + e.message);
  }
}

async function refreshUploadJobs() {
  if (currentCfgSlot == null) return;
  try {
    const { jobs, counts } = await api('GET', '/sdrs/' + currentCfgSlot + '/upload-jobs');
    const map = { pending: 0, sent: 0, error: 0 };
    counts.forEach(c => map[c.status] = c.n);
    $('#cfg-upload-summary').innerHTML = `
      <div><b>${map.pending}</b>Pendentes</div>
      <div><b>${map.sent}</b>Enviados</div>
      <div><b>${map.error}</b>Erros</div>
    `;
    const total = (map.pending || 0) + (map.sent || 0) + (map.error || 0);
    const savedCountEl = $('#cfg-saved-count');
    if (savedCountEl) savedCountEl.textContent = total ? `${total} salvo${total > 1 ? 's' : ''}` : '';
    $('#cfg-upload-jobs').innerHTML = jobs.map(j => `
      <div class="upload-job-item">
        <div>+${j.target_phone}${j.target_name ? ' · ' + j.target_name : ''}<br><span style="font-size:10px;color:var(--subtext)">${j.error || ''}</span></div>
        <div style="display:flex;align-items:center;gap:8px">
          <div class="st-pill ${j.status}">${j.status}</div>
          <button onclick="deleteUploadJob(${j.id})" title="Excluir contato" style="background:none;border:none;cursor:pointer;color:var(--subtext);font-size:14px;padding:2px 4px;line-height:1;border-radius:4px" onmouseover="this.style.color='#e53e3e'" onmouseout="this.style.color='var(--subtext)'">✕</button>
        </div>
      </div>
    `).join('') || '<div style="color:var(--subtext);padding:12px 0">nenhum contato cadastrado ainda. use "+ Adicionar" ou cole uma lista abaixo.</div>';
  } catch (e) {
    console.error('refreshUploadJobs', e);
  }
}

async function deleteUploadJob(id) {
  if (currentCfgSlot == null) return;
  try { await api('DELETE', '/sdrs/' + currentCfgSlot + '/upload-jobs/' + id); refreshUploadJobs(); } catch (e) { alert(e.message); }
}

async function clearPendingJobs() {
  if (currentCfgSlot == null) return;
  if (!confirm('Cancelar todos os pendentes deste SDR?')) return;
  try { await api('DELETE', '/sdrs/' + currentCfgSlot + '/upload-jobs'); refreshUploadJobs(); } catch (e) { alert(e.message); }
}

function startPolling() {
  if (pollInterval) clearInterval(pollInterval);
  pollInterval = setInterval(() => {
    if (currentConnectSlot != null) refreshConnectModal();
    if (currentView === 'sdrs') {
      const ae = document.activeElement;
      const editingCard = ae && ae.tagName === 'INPUT' && ae.closest && ae.closest('#sdr-grid');
      if (!editingCard) loadSdrs();
    }
    else if (currentView === 'conversations') {
      loadConversations();
      if (currentChat) loadMessages();
    }
    else if (currentView === 'maturation') loadMaturation();
  }, 3000);
}

// Boot
(async () => {
  try {
    const res = await api('GET', '/auth/whoami');
    currentUser = res.user;
    enterApp();
  } catch {
    $('#login-pass').focus();
  }
})();
$('#login-pass').addEventListener('keydown', (e) => { if (e.key === 'Enter') doLogin(); });
</script>
