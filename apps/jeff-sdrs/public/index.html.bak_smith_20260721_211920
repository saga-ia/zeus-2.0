</div>

<!-- MODAL: Conectar chip -->
<div id="modal-connect" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-header">
      <div>
        <div class="modal-title">Conectar chip <span id="connect-slot-label" style="color:var(--subtext);font-weight:500"></span></div>
        <div class="modal-sub" id="connect-sdr-name">Escolha como quer parear o número.</div>
      </div>
      <button class="modal-close" onclick="closeConnectModal()">×</button>
    </div>
    <div class="tabs">
      <div class="tab active" data-tab="qr" onclick="switchConnectTab('qr')">QR Code</div>
      <div class="tab" data-tab="token" onclick="switchConnectTab('token')">Código de 8 dígitos</div>
    </div>

    <div id="tab-qr" class="tab-panel active">
      <div id="qr-canvas-wrap-modal" class="qr-canvas-wrap"><img id="qr-img-modal" alt="QR code" style="display:none;width:240px;height:240px"><canvas id="qr-canvas-modal"></canvas></div>
      <div id="qr-status" class="pair-code-loading" style="display:none">Gerando QR code, aguarde…</div>
      <div class="qr-steps">
        <b>Como escanear:</b><br>
        1. Abra o WhatsApp no celular do chip<br>
        2. Toque em <b>Configurações → Aparelhos conectados</b><br>
        3. Toque em <b>Conectar aparelho</b> e aponte pra tela
      </div>
      <button class="btn btn-ghost btn-full" style="margin-top:12px" onclick="regenerateQr()">🔄 Gerar novo QR code</button>
    </div>

    <div id="tab-token" class="tab-panel">
      <div class="form-group">
        <label>Número com DDI e DDD (só dígitos)</label>
        <input id="pair-phone" type="tel" placeholder="5511999999999" />
      </div>
      <button id="pair-code-btn" class="btn btn-primary btn-full" onclick="requestPairCode(false)">Gerar código</button>
      <div id="pair-code-display" style="display:none">
        <div class="pair-code-box" id="pair-code-value">--------</div>
        <div class="qr-steps">
          <b>Como usar o código:</b><br>
          1. Abra o WhatsApp no celular<br>
          2. Toque em <b>Aparelhos conectados → Conectar aparelho</b><br>
          3. Toque em <b>Conectar com número de telefone</b><br>
          4. Digite o código acima
        </div>
        <button class="btn btn-ghost btn-full" style="margin-top:12px" onclick="requestPairCode(true)">🔄 Gerar novo código</button>
      </div>
      <div id="pair-code-loading" class="pair-code-loading" style="display:none">Gerando código, aguarde…</div>
    </div>

    <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border)">
      <button class="btn btn-danger btn-full" onclick="disconnectFromConnectModal()">🔌 Desconectar WhatsApp desse slot</button>
      <div style="font-size:11px;color:var(--subtext);text-align:center;margin-top:6px">
        Desassocia o chip no celular. Vai precisar parear de novo pra reconectar.
      </div>
    </div>
  </div>
</div>

<!-- MODAL: Instruções do SDR -->
<div id="modal-instructions" class="modal-overlay" style="display:none">
  <div class="modal" style="max-width:680px">
    <div class="modal-header">
      <div>
        <div class="modal-title">Instruções do SDR <span id="instr-slot-label" style="color:var(--subtext);font-weight:500"></span></div>
        <div class="modal-sub">O que esse SDR deve fazer, tom de voz, roteiro de qualificação, links pra passar. O agente lê isso quando for responder.</div>
      </div>
      <button class="modal-close" onclick="closeInstructionsModal()">×</button>
    </div>
    <div class="form-group">
      <label>Instruções</label>
      <textarea id="instructions-body" class="instructions-textarea" placeholder="Ex:&#10;&#10;Você é o SDR de pré-vendas da Alpha Digital.&#10;&#10;Objetivo: qualificar o lead que veio do anúncio e agendar reunião de diagnóstico.&#10;&#10;Perguntas chave:&#10;1. Qual o faturamento atual?&#10;2. Já investe em tráfego?&#10;3. Quando pretende começar?&#10;&#10;Se qualificar, envie o link: https://..."></textarea>
      <div id="instructions-meta" class="instructions-meta"></div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeInstructionsModal()">Cancelar</button>
      <button class="btn btn-primary" onclick="saveInstructions()">Salvar instruções</button>
    </div>
  </div>
</div>

<!-- MODAL: Configurações do SDR -->
<div id="modal-config" class="modal-overlay" style="display:none">
  <div class="modal" style="max-width:780px">
    <div class="modal-header">
      <div>
        <div class="modal-title">Configurações do SDR <span id="cfg-slot-label" style="color:var(--subtext);font-weight:500"></span></div>
        <div class="modal-sub">Escolha se o SDR é ativo (dispara contato) ou receptivo (responde quando chega palavra-gatilho).</div>
      </div>
      <button class="modal-close" onclick="closeConfigModal()">×</button>
    </div>

    <div class="form-group">
      <label>Modo de operação</label>
      <div class="select-mode" id="cfg-sdr-mode">
        <div data-sdrmode="ativo" onclick="setSdrMode('ativo')">🚀 Ativo (dispara contato)</div>
        <div data-sdrmode="receptivo" onclick="setSdrMode('receptivo')">📥 Receptivo (responde gatilho)</div>
      </div>
      <div class="config-hint">
        <b>Ativo</b>: você sobe uma lista de contatos e o SDR inicia a conversa disparando as mensagens gatilho em rodízio.
        <b>Receptivo</b>: o SDR fica esperando; assim que uma palavra-gatilho aparecer numa mensagem recebida, ele assume a conversa.
      </div>
    </div>

    <div class="tabs" id="cfg-tabs-container"></div>

    <!-- ATIVO: Instruções de disparo (mensagem inicial em rodízio) -->
    <div id="cfgtab-disparo" class="tab-panel">
      <label>Instruções pra iniciar a conversa</label>
      <textarea id="cfg-init-instructions" style="min-height:100px" placeholder="Ex: Ao iniciar contato, apresente-se como Ana da Alpha, mencione o motivo do contato, seja calorosa."></textarea>
      <div class="config-hint">Diretriz de tom / abordagem que o SDR usa nesse primeiro contato.</div>

      <label style="margin-top:16px">Mensagens de disparo (rodízio pra evitar bloqueio)</label>
      <div id="cfg-dispatch-list"></div>
      <button class="btn btn-ghost btn-sm" onclick="addDispatchMessage('')" style="margin-top:6px">+ adicionar variação</button>
      <div class="config-hint">
        Cada envio usa uma variação diferente em rodízio. Use <b>{nome}</b> pra puxar o nome do contato da lista. Recomendado: 3 a 5 variações bem diferentes.
      </div>

      <label style="margin-top:16px">Delay entre disparos (segundos)</label>
      <div class="form-row" style="margin-bottom:6px">
        <div><label>Mínimo</label><input id="cfg-dispatch-min" type="number" min="3" max="3600" value="30" /></div>
        <div><label>Máximo</label><input id="cfg-dispatch-max" type="number" min="3" max="3600" value="60" /></div>
      </div>
      <div class="config-hint">Entre um envio e o próximo o sistema espera um tempo aleatório entre mínimo e máximo.</div>

      <label style="margin-top:16px">Pausa a cada N envios</label>
      <div class="form-row" style="margin-bottom:6px">
        <div><label>A cada N mensagens</label><input id="cfg-pause-every" type="number" min="1" max="1000" value="10" /></div>
        <div><label>Pausa (segundos)</label><input id="cfg-pause-secs" type="number" min="0" max="86400" value="300" /></div>
      </div>
      <div class="config-hint">Depois de N envios, o SDR pausa X segundos. Coloque 0 nos segundos pra desativar a pausa.</div>
    </div>

    <!-- ATIVO: Lista de contatos -->
    <div id="cfgtab-lista" class="tab-panel">
      <label style="display:flex;align-items:center;justify-content:space-between">
        <span>Contatos cadastrados</span>
        <span id="cfg-saved-count" style="font-size:12px;color:var(--subtext);font-weight:400"></span>
      </label>
      <div class="upload-summary" id="cfg-upload-summary"></div>
      <div class="upload-jobs-list" id="cfg-upload-jobs" style="border:1px solid var(--border);border-radius:10px;padding:8px 12px;min-height:60px;max-height:240px"></div>
      <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
        <button class="btn btn-ghost btn-sm" onclick="clearPendingJobs()">Cancelar pendentes</button>
      </div>

      <label style="margin-top:18px">+ Cadastrar contato manual</label>
      <div class="chip-input-row" style="gap:6px;flex-wrap:wrap">
        <input id="cfg-manual-phone" type="text" placeholder="Numero com DDI+DDD (ex: 5511999998888)" style="flex:2 1 200px" onkeydown="if(event.key==='Enter'){event.preventDefault();onManualEnter('phone')}" />
        <input id="cfg-manual-name" type="text" placeholder="Nome (opcional)" style="flex:1 1 140px" onkeydown="if(event.key==='Enter'){event.preventDefault();onManualEnter('name')}" />
        <button class="btn btn-primary btn-sm" onclick="addManualContact()">+ Adicionar</button>
      </div>
      <div class="config-hint">Cada contato adicionado é salvo na hora e aparece na lista de cadastrados acima.</div>

      <label style="margin-top:18px">Ou colar lista inteira (um por linha: número,nome)</label>
      <textarea id="cfg-list-input" style="min-height:120px" placeholder="55119XXXXXXXX,Fulano&#10;55119YYYYYYYY,Beltrano&#10;5562988887777,Maria"></textarea>
      <div class="config-hint">
        Aceita colar direto do Excel / CSV (número, nome). Aceita também nome vindo antes do número. Todo telefone precisa ter <b>DDI+DDD</b>. Número curto é ignorado.
      </div>
      <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
        <button class="btn btn-primary btn-sm" onclick="submitContactList()">Salvar lista</button>
        <label class="btn btn-ghost btn-sm" style="cursor:pointer">
          📎 Enviar arquivo txt / csv / xlsx
          <input type="file" accept=".txt,.csv,.tsv,.xlsx,.xls" style="display:none" onchange="uploadFile(event)" />
        </label>
        <button class="btn btn-ghost btn-sm" onclick="clearListInput()">Limpar caixa</button>
      </div>

      <label style="margin-top:18px">Ou link de Google Sheets (planilha pública ou "qualquer pessoa com link")</label>
      <div class="chip-input-row">
        <input id="cfg-sheet-url" type="url" placeholder="https://docs.google.com/spreadsheets/d/..." />
        <button class="btn btn-primary btn-sm" onclick="submitSheetUrl()">Puxar da planilha</button>
      </div>
      <div class="config-hint">
        A planilha precisa ter colunas: <b>número</b> na primeira e <b>nome</b> (opcional) na segunda. Compartilhamento tem que estar liberado pra "qualquer pessoa com link".
      </div>
    </div>

    <!-- RECEPTIVO: Palavras gatilho -->
    <div id="cfgtab-gatilhos" class="tab-panel">
      <label>Palavras ou frases que ativam este SDR</label>
      <div class="chip-row" id="cfg-triggers-chips"></div>
      <div class="chip-input-row">
        <input id="cfg-trigger-input" type="text" placeholder="ex: quero saber mais, kit congresso, comprar" onkeydown="if(event.key==='Enter'){event.preventDefault();addTriggerFromInput()}" />
        <button class="btn btn-primary btn-sm" onclick="addTriggerFromInput()">+ Adicionar</button>
      </div>
      <div class="config-hint">
        Quando qualquer palavra dessa lista aparecer em uma mensagem recebida, o SDR assume a conversa e ela fica isolada nele. Case-insensitive.
      </div>

      <label style="margin-top:16px">Mensagem inicial ao ativar (opcional)</label>
      <textarea id="cfg-welcome" style="min-height:100px" placeholder="Ex: Oi {nome}, vi que você mostrou interesse. Posso te passar mais detalhes?"></textarea>
      <div class="config-hint">Enviada uma vez quando o gatilho é detectado. Deixe vazio pra ele não mandar nada e só continuar a conversa.</div>
    </div>

    <!-- Conversa (comum aos dois modos) -->
    <div id="cfgtab-conversa" class="tab-panel">
      <label>Instruções da conversa</label>
      <textarea id="cfg-conversation-instructions" style="min-height:220px" placeholder="Como o SDR deve conduzir a conversa. Objetivo, perguntas de qualificação, o que oferecer, o que evitar, quando encaminhar pra humano, links pra passar."></textarea>
      <div class="config-hint">
        O agente lê essas instruções ao responder cada mensagem. Seja específico: script, tom de voz, tabu, ordem das perguntas.
      </div>

      <label style="margin-top:16px">Personalidade (0 = ao pé da letra · 10 = criatividade máxima)</label>
      <div style="display:flex;align-items:center;gap:12px;margin-top:6px">
        <input id="cfg-personality" type="range" min="0" max="10" step="1" value="5" oninput="document.getElementById('cfg-personality-val').textContent = this.value" style="flex:1" />
        <div id="cfg-personality-val" style="width:32px;text-align:center;font-weight:800;color:var(--accent);font-size:18px">5</div>
      </div>
      <div class="config-hint">
        Baixo (0-3): rígido, respostas quase idênticas ao script. Médio (4-6): equilibra script e naturalidade. Alto (7-10): mais espontâneo, adapta ao cliente.
      </div>

      <label style="margin-top:16px">Link de referência (site do cliente / material)</label>
      <input id="cfg-reference-url" type="url" placeholder="https://empresadocliente.com.br" />
      <div class="config-hint">O SDR consulta esse link (e sub-páginas) pra responder dúvidas do cliente sobre a empresa / produto.</div>

      <div style="margin-top:22px;border-top:1px solid var(--border);padding-top:16px">
        <label style="font-weight:700;font-size:14px">🤖 Inteligência Artificial (SDR receptivo)</label>
        <div class="config-hint">
          Escolha a chave / modelo que este SDR usa pra responder no modo receptivo. Se nenhuma chave for escolhida, o SDR NÃO responde por IA (o fluxo antigo do Zeus continua funcionando pra ele).
        </div>

        <label style="margin-top:12px">Chave de API</label>
        <select id="cfg-ai-key" style="width:100%">
          <option value="">— não usar IA (deixa Zeus / manual) —</option>
        </select>
        <div class="config-hint">Chaves cadastradas em "Configurações do Sistema". Só admin cadastra chaves novas.</div>

        <div class="form-row" style="margin-top:12px">
          <div>
            <label>Provider</label>
            <select id="cfg-ai-provider" onchange="onProviderChange()">
              <option value="">— usar o do cadastro da chave —</option>
              <option value="anthropic">Anthropic</option>
              <option value="openai">OpenAI</option>
              <option value="gemini">Gemini</option>
            </select>
          </div>
          <div>
            <label>Modelo</label>
            <select id="cfg-ai-model"></select>
          </div>
        </div>

        <label style="margin-top:12px">Limite diário de respostas por IA</label>
        <input id="cfg-ai-daily-limit" type="number" min="0" max="10000" value="20" />
        <div class="config-hint">Depois desse limite no dia, o SDR para de responder por IA até o dia seguinte (BRT). Use 0 pra desativar o limite.</div>

        <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
          <button class="btn btn-ghost btn-sm" onclick="pauseAI(10)">⏸ Pausar IA por 10 min</button>
          <button class="btn btn-ghost btn-sm" onclick="resumeAI()">▶ Retomar agora</button>
          <span id="cfg-ai-paused-info" style="font-size:12px;color:var(--subtext)"></span>
        </div>
        <div id="cfg-ai-stats" style="font-size:12px;color:var(--subtext);margin-top:8px"></div>
      </div>

      <!-- Recursos de envio -->
      <div style="margin-top:22px;border-top:1px solid var(--border);padding-top:16px">
        <label style="font-weight:700;font-size:14px">📎 Recursos de envio (link / arquivo / imagem)</label>
        <div class="config-hint">
          Quando ligados, o SDR pode enviar esses itens durante a conversa. Descreva no "quando enviar" o momento certo (ex: "após qualificar o lead", "quando pedir o material", "quando pedir foto do produto").
        </div>

        <!-- Link -->
        <div style="margin-top:14px;padding:10px;border:1px solid var(--border);border-radius:10px">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input id="cfg-send-link-enabled" type="checkbox" onchange="toggleMediaBlock('link')" />
            <span style="font-weight:600">Enviar link</span>
          </label>
          <div id="cfg-send-link-body" style="display:none;margin-top:10px">
            <label>URL</label>
            <input id="cfg-send-link-url" type="url" placeholder="https://..." />
            <label style="margin-top:8px">Quando enviar (descreva o gatilho)</label>
            <input id="cfg-send-link-trigger" type="text" placeholder="ex: após o lead confirmar interesse" />
          </div>
        </div>

        <!-- Arquivo -->
        <div style="margin-top:10px;padding:10px;border:1px solid var(--border);border-radius:10px">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input id="cfg-send-file-enabled" type="checkbox" onchange="toggleMediaBlock('file')" />
            <span style="font-weight:600">Enviar arquivo (PDF, docx, etc)</span>
          </label>
          <div id="cfg-send-file-body" style="display:none;margin-top:10px">
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
              <label class="btn btn-ghost btn-sm" style="cursor:pointer">
                📎 Escolher arquivo
                <input type="file" style="display:none" onchange="uploadMedia(event,'file')" />
              </label>
              <span id="cfg-send-file-name" style="font-size:12px;color:var(--subtext)">(nenhum arquivo enviado)</span>
            </div>
            <label style="margin-top:8px">Quando enviar (descreva o gatilho)</label>
            <input id="cfg-send-file-trigger" type="text" placeholder="ex: quando o cliente pedir o material" />
          </div>
        </div>

        <!-- Imagem -->
        <div style="margin-top:10px;padding:10px;border:1px solid var(--border);border-radius:10px">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input id="cfg-send-image-enabled" type="checkbox" onchange="toggleMediaBlock('image')" />
            <span style="font-weight:600">Enviar imagem</span>
          </label>
          <div id="cfg-send-image-body" style="display:none;margin-top:10px">
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
              <label class="btn btn-ghost btn-sm" style="cursor:pointer">
                🖼 Escolher imagem
                <input type="file" accept="image/*" style="display:none" onchange="uploadMedia(event,'image')" />
              </label>
              <span id="cfg-send-image-name" style="font-size:12px;color:var(--subtext)">(nenhuma imagem enviada)</span>
            </div>
            <label style="margin-top:8px">Quando enviar (descreva o gatilho)</label>
            <input id="cfg-send-image-trigger" type="text" placeholder="ex: quando o cliente pedir foto" />
          </div>
        </div>
      </div>
    </div>

    <!-- Avançado -->
    <div id="cfgtab-avancado" class="tab-panel">
      <div class="form-group">
        <label>Modo de gatilho (só p/ receptivo)</label>
        <div class="select-mode" id="cfg-trigger-mode">
          <div data-mode="any" onclick="setTriggerMode('any')">Padrão</div>
          <div data-mode="strict" onclick="setTriggerMode('strict')">Estrito</div>
        </div>
        <div class="config-hint">
          <b>Padrão</b>: se não bater gatilho de nenhum slot deste chip, este SDR pega a conversa mesmo assim (fallback).<br>
          <b>Estrito</b>: só assume conversa quando o gatilho for detectado.
        </div>
      </div>
      <div class="form-group">
        <label>Slot master (compartilhar chip com outro slot)</label>
        <select id="cfg-master-slot">
          <option value="">— este slot usa seu próprio chip —</option>
        </select>
        <div class="config-hint">
          Se você quer que este SDR use o MESMO WhatsApp de outro slot, aponte pra ele aqui.
        </div>
      </div>
    </div>

    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeConfigModal()">Cancelar</button>
      <button class="btn btn-primary" onclick="saveConfig()">Salvar configurações</button>
    </div>
  </div>
</div>

<!-- MODAL: Configurações do Sistema (admin) -->
<div id="modal-system" class="modal-overlay" style="display:none">
  <div class="modal" style="max-width:720px">
    <div class="modal-header">
      <div>
        <div class="modal-title">Configurações do Sistema</div>
        <div class="modal-sub">Chaves globais de API usadas pelos SDRs. Só admin vê essa tela.</div>
      </div>
      <button class="modal-close" onclick="closeSystemModal()">×</button>
    </div>

    <div class="form-group">
      <label style="font-weight:700;font-size:14px">Chaves de API</label>
      <div class="config-hint">
        Cadastre chaves de provedores de IA (Anthropic, OpenAI, Gemini). Cada SDR escolhe qual usar na sua tela de configuração.
        A chave só aparece pelos últimos 4 dígitos depois de salva — a versão completa fica criptografada no servidor (AES-256-GCM).
      </div>

      <div id="sys-keys-list" style="border:1px solid var(--border);border-radius:10px;padding:8px 12px;min-height:60px;margin-top:10px"></div>

      <div style="margin-top:16px;padding:12px;border:1px dashed var(--border);border-radius:10px">
        <label>Nova chave</label>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px">
          <select id="sys-key-provider" style="flex:1 1 140px">
            <option value="anthropic">Anthropic</option>
            <option value="openai">OpenAI</option>
            <option value="gemini">Gemini</option>
          </select>
          <input id="sys-key-label" type="text" placeholder="Apelido (ex: anthropic-prod)" style="flex:2 1 200px" />
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px">
          <input id="sys-key-value" type="password" placeholder="Cole a chave aqui (ex: sk-ant-... / sk-... / AIza...)" style="flex:2 1 300px" autocomplete="new-password" />
          <button class="btn btn-primary btn-sm" onclick="submitNewKey()">+ Cadastrar</button>
        </div>
        <div class="config-hint" style="margin-top:4px">Cheque o console do provedor pra pegar a chave. Depois de salvar, a chave completa não é mais exibida.</div>
      </div>
    </div>

    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeSystemModal()">Fechar</button>
    </div>
  </div>
</div>

<script>
const $ = (s) => document.querySelector(s);
const $$ = (s) => document.querySelectorAll(s);
// Escape HTML pra evitar XSS armazenado quando um campo do backend cai em innerHTML.
const esc = (v) => String(v == null ? '' : v)
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/'/g, '&#39;');
const api = async (method, path, body) => {
  const r = await fetch('/api' + path, {
    method,
    credentials: 'include',
    headers: { 'Content-Type': 'application/json' },
    body: body ? JSON.stringify(body) : undefined,
  });
  if (!r.ok) {
    const err = await r.json().catch(() => ({}));
    throw new Error(err.error || `HTTP ${r.status}`);
  }
  return r.json();
};

let currentView = 'sdrs';
let currentUser = null;
let sdrsCache = [];
let currentChat = null;
let pollInterval = null;

async function doLogin() {
  $('#login-error').textContent = '';
  const username = $('#login-user').value.trim();
  const password = $('#login-pass').value;
  if (!username || !password) { $('#login-error').textContent = 'preencha usuário e senha'; return; }
  try {
    const res = await api('POST', '/auth/login', { username, password });
    currentUser = res.user;
    enterApp();
  } catch (e) {
    $('#login-error').textContent = 'usuário ou senha inválidos';
  }
}

async function doForgot() {
  const username = ($('#login-user').value || '').trim();
  if (!username) { $('#login-error').textContent = 'informa o usuario primeiro'; return; }
  $('#login-error').textContent = '';
  $('#forgot-msg').textContent = 'enviando...';
  try {
    await api('POST', '/auth/forgot', { username });
    $('#forgot-msg').textContent = 'senha nova enviada no WhatsApp do Jeff';
  } catch {
    $('#forgot-msg').textContent = '';
    $('#login-error').textContent = 'falha ao enviar, chama o Zeus';
  }
}

async function doLogout() {
  try { await api('POST', '/auth/logout'); } catch {}
  location.reload();
}

async function enterApp() {
  $('#login-screen').style.display = 'none';
  $('#app-screen').style.display = 'block';
  $('#user-name').textContent = currentUser.display_name || currentUser.username;
  $('#user-role').textContent = currentUser.role;
  if (currentUser.role === 'admin') {
    const el = document.getElementById('side-system');
    if (el) el.style.display = '';
  }
  await loadSdrs();
  startPolling();
}

/* ====== Configurações do Sistema (chaves de API) ====== */
let sysModelsCache = null;

async function openSystemModal() {
  document.getElementById('modal-system').style.display = 'flex';
  await refreshKeys();
}
function closeSystemModal() {
  document.getElementById('modal-system').style.display = 'none';
}
async function refreshKeys() {
  try {
    const res = await api('GET', '/system/keys');
    sysModelsCache = res.models;
    const box = document.getElementById('sys-keys-list');
    if (!res.keys.length) {
      box.innerHTML = '<div style="color:var(--subtext);padding:8px 0">nenhuma chave cadastrada.</div>';
      return;
    }
    box.innerHTML = res.keys.map(k => `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px dashed var(--border)">
        <div>
          <b>${esc(k.label)}</b>
          <span style="color:var(--subtext);margin-left:8px;font-size:12px">${esc(k.provider)} · ****${esc(k.key_last4)}</span>
        </div>
        <button class="btn btn-ghost btn-sm" onclick="deleteKey(${k.id})" title="Excluir chave">🗑</button>
      </div>
    `).join('');
  } catch (e) { alert('Erro carregando chaves: ' + e.message); }
}
async function submitNewKey() {
  const provider = document.getElementById('sys-key-provider').value;
  const label = document.getElementById('sys-key-label').value.trim();
  const key = document.getElementById('sys-key-value').value.trim();
  if (!key) return alert('Cole a chave.');
  try {
    await api('POST', '/system/keys', { provider, label, key });
    document.getElementById('sys-key-label').value = '';
    document.getElementById('sys-key-value').value = '';
    await refreshKeys();
    alert('Chave cadastrada.');
  } catch (e) { alert('Erro ao salvar: ' + e.message); }
}
async function deleteKey(id) {
  if (!confirm('Excluir esta chave? SDRs que usam ela pararão de responder por IA.')) return;
  try {
    await api('DELETE', '/system/keys/' + id);
    await refreshKeys();
  } catch (e) { alert('Erro: ' + e.message); }
}

/* ====== IA na tela do SDR ====== */
let cfgAvailableKeys = [];
let cfgAiProviderSelected = '';
function providerModels(provider) {
  const map = sysModelsCache || {
    anthropic: { default: 'claude-sonnet-4-6', options: ['claude-sonnet-4-6', 'claude-opus-4-7', 'claude-haiku-4-5-20251001'] },
    openai:    { default: 'gpt-4o-mini',      options: ['gpt-4o-mini', 'gpt-4o', 'gpt-4-turbo'] },
    gemini:    { default: 'gemini-2.0-flash-exp', options: ['gemini-2.0-flash-exp', 'gemini-1.5-pro'] },
  };
  return map[provider] || null;
}
function onProviderChange() {
  const provSel = document.getElementById('cfg-ai-provider');
  const modelSel = document.getElementById('cfg-ai-model');
  const prov = provSel.value || inferProviderFromSelectedKey();
  const m = providerModels(prov);
  if (!m) { modelSel.innerHTML = '<option value="">—</option>'; return; }
  modelSel.innerHTML = m.options.map(o => `<option value="${o}">${o}</option>`).join('');
  modelSel.value = m.default;
}
function inferProviderFromSelectedKey() {
  const sel = document.getElementById('cfg-ai-key');
  const id = sel.value ? parseInt(sel.value, 10) : null;
  const k = cfgAvailableKeys.find(k => k.id === id);
  return k ? k.provider : '';
}
async function pauseAI(minutes) {
  if (currentCfgSlot == null) return;
  try {
    await api('POST', '/sdrs/' + currentCfgSlot + '/ai-pause', { minutes });
    alert(`IA pausada por ${minutes} min.`);
    await refreshAiInfo();
  } catch (e) { alert('Erro: ' + e.message); }
}
async function resumeAI() {
  if (currentCfgSlot == null) return;
  try {
    await api('POST', '/sdrs/' + currentCfgSlot + '/ai-resume');
    await refreshAiInfo();
  } catch (e) { alert('Erro: ' + e.message); }
}
async function refreshAiInfo() {
  if (currentCfgSlot == null) return;
  try {
    const { sdr } = await api('GET', '/sdrs/' + currentCfgSlot + '/config');
    const el = document.getElementById('cfg-ai-paused-info');
    if (sdr.ai_paused_until && new Date(sdr.ai_paused_until).getTime() > Date.now()) {
      el.textContent = 'pausado até ' + new Date(sdr.ai_paused_until).toLocaleString('pt-BR');
    } else {
      el.textContent = '';
    }
    const stats = await api('GET', '/sdrs/' + currentCfgSlot + '/ai-stats');
    document.getElementById('cfg-ai-stats').textContent = `Usadas hoje: ${stats.used_today} de ${sdr.ai_daily_limit || 20}`;
  } catch {}
}

function showView(name) {
  currentView = name;
  $$('.view').forEach(el => el.style.display = 'none');
  $('#view-' + name).style.display = 'block';
  $$('.side-item').forEach(el => el.classList.toggle('active', el.dataset.view === name));
  if (name === 'sdrs') loadSdrs();
  if (name === 'conversations') { loadConversations(); populateConvFilter(); }
  if (name === 'maturation') { loadMaturation(); }
}

function statusBadge(status) {
  const label = { idle: 'desligado', connecting: 'conectando', qr: 'escaneie', ready: 'ativo', disconnected: 'off' }[status] || status;
  return `<span class="badge badge-${status}">${label}</span>`;
}

async function loadSdrs() {
  const { sdrs } = await api('GET', '/sdrs');
  sdrsCache = sdrs;
  const grid = $('#sdr-grid');
  grid.innerHTML = '';
  sdrs.forEach(s => {
    const card = document.createElement('div');
    card.className = 'sdr-card status-' + s.status;
    const zeusOn = !!s.zeus_mode;
    let primaryBtn;
    let secondaryBtn = '';
    const disconnectBtn = `<button class="btn btn-danger btn-sm btn-full-w" onclick="disconnectSlot(${s.slot})">🔌 Desconectar WhatsApp</button>`;
    if (zeusOn) {
      primaryBtn = `<button class="btn btn-danger btn-sm btn-full-w" onclick="disableZeusMode(${s.slot})">Desativar Zeus</button>`;
      if (s.status === 'ready' || s.status === 'qr' || s.status === 'connecting') {
        secondaryBtn = disconnectBtn;
      } else {
        secondaryBtn = `<button class="btn btn-primary btn-sm btn-full-w" onclick="openConnectModalFromZeus(${s.slot})">🔌 Conectar chip via QR/Token</button>`;
      }
    } else if (s.status === 'idle' || s.status === 'disconnected') {
      // Botao principal VERDE: conecta WhatsApp direto (abre modal QR/Token).
      // Secundario ghost: fluxo antigo "Ativar SDR" (escolha Zeus ou chip).
      primaryBtn = `<button class="btn btn-success btn-sm btn-full-w" onclick="openConnectModal(${s.slot})">🔌 Conectar WhatsApp</button>`;
      secondaryBtn = `<button class="btn btn-ghost btn-sm btn-full-w" onclick="openActivateModal(${s.slot})">⚡ Ativar SDR (Zeus ou chip)</button>`;
    } else if (s.status === 'connecting') {
      primaryBtn = `<button class="btn btn-ghost btn-sm btn-full-w" disabled>conectando…</button>`;
      // Botao secundario: desconectar cancela a tentativa e libera o slot.
      secondaryBtn = disconnectBtn;
    } else if (s.status === 'qr') {
      // Quando ja tem QR ativo, botao principal reabre o modal de conectar chip direto (nao volta pra escolha).
      primaryBtn = `<button class="btn btn-success btn-sm btn-full-w" onclick="openConnectModal(${s.slot})">🔌 Conectar WhatsApp (ver QR / Token)</button>`;
      secondaryBtn = disconnectBtn;
    } else {
      primaryBtn = disconnectBtn;
    }
    const hasInstructions = !!(s.instructions && s.instructions.trim());
    const activeOn = !!s.ai_active;
    const isAtivoMode = s.sdr_mode === 'ativo';
    const dispatchRunning = !!s.dispatch_running;
    const pending = s.upload_pending || 0;
    const sent = s.upload_sent || 0;
    const errored = s.upload_error || 0;
    let dispatchBlock = '';
    if (isAtivoMode) {
      const hasHistory = (sent + errored) > 0;
      const btn = dispatchRunning
        ? `<button class="btn btn-danger btn-sm btn-full-w" onclick="pauseDispatch(${s.slot})">⏸ Pausar atendimento</button>`
        : (pending > 0
            ? `<button class="btn btn-primary btn-sm btn-full-w" onclick="startDispatch(${s.slot})">▶ Iniciar atendimento</button>`
            : (hasHistory
                ? `<button class="btn btn-primary btn-sm btn-full-w" onclick="resetAndStart(${s.slot}, ${sent + errored})">🔄 Reiniciar atendimento</button>`
                : `<button class="btn btn-primary btn-sm btn-full-w" disabled title="Sem contatos na fila">▶ Iniciar atendimento</button>`));
      const statusLine = dispatchRunning
        ? `<span style="color:var(--green);font-weight:600">rodando</span> · ${sent} enviados · ${pending} na fila${errored ? ' · ' + errored + ' erro' : ''}`
        : `parado · ${sent} enviados · ${pending} na fila${errored ? ' · ' + errored + ' erro' : ''}`;
      dispatchBlock = `
        <div class="sdr-actions-row" style="width:100%">${btn}</div>
        <div style="font-size:11px;color:var(--subtext);text-align:center;margin-top:-4px">${statusLine}</div>
      `;
    } else {
      // Modo receptivo: botao "Iniciar atendimento" liga o SDR (ai_active=1).
      // Nao ha fila de disparo, mas o botao serve pra Jeff sinalizar "esta operando".
      const btn = dispatchRunning
        ? `<button class="btn btn-danger btn-sm btn-full-w" onclick="pauseDispatch(${s.slot})">⏸ Pausar atendimento</button>`
        : `<button class="btn btn-primary btn-sm btn-full-w" onclick="startDispatch(${s.slot})">▶ Iniciar atendimento</button>`;
      const statusLine = dispatchRunning
        ? `<span style="color:var(--green);font-weight:600">atendendo</span> · aguardando mensagens de leads`
        : `pausado · botao inicia atendimento receptivo`;
      dispatchBlock = `
        <div class="sdr-actions-row" style="width:100%">${btn}</div>
        <div style="font-size:11px;color:var(--subtext);text-align:center;margin-top:-4px">${statusLine}</div>
      `;
    }
    card.innerHTML = `
      <div class="sdr-header">
        <div class="sdr-slot">SLOT ${s.slot}</div>
        ${statusBadge(s.status)}
      </div>
      <div class="toggle-active ${activeOn ? 'on' : ''}" onclick="toggleSlotActive(${s.slot})" title="Ligar/pausar agente deste SDR">
        <div class="sw"></div>
        <div class="lbl">${activeOn ? 'ATIVO' : 'PAUSADO'}</div>
      </div>
      <div class="sdr-name-row">
        <input value="${esc(s.name)}" placeholder="Nome do SDR" data-slot="${s.slot}" data-field="name" />
        <input class="role" value="${esc(s.role_label)}" placeholder="Cargo / função (ex: Pré-vendas)" data-slot="${s.slot}" data-field="role_label" />
      </div>
      <div class="sdr-phone">${zeusOn ? '⚡ Atendendo via Zeus' : (s.phone ? '+' + esc(s.phone) : (s.status === 'qr' ? 'aguardando pareamento' : 'sem chip'))}</div>
      <div class="sdr-actions">
        <div class="sdr-actions-row" style="width:100%">${primaryBtn}</div>
        ${secondaryBtn ? `<div class="sdr-actions-row" style="width:100%">${secondaryBtn}</div>` : ''}
        ${dispatchBlock}
        <div class="sdr-actions-row" style="width:100%">
          <button class="btn btn-ghost btn-sm btn-full-w" onclick="openInstructionsModal(${s.slot})">
            📝 Instruções${hasInstructions ? ' ✓' : ''}
          </button>
        </div>
        <div class="sdr-actions-row" style="width:100%">
          <button class="btn btn-ghost btn-sm btn-full-w" onclick="openConfigModal(${s.slot})">
            ⚙️ Configurações
          </button>
        </div>
      </div>
    `;
    grid.appendChild(card);
  });
  grid.querySelectorAll('input').forEach(inp => {
    inp.addEventListener('blur', async () => {
      const slot = parseInt(inp.dataset.slot, 10);
      const field = inp.dataset.field;
      try { await api('PATCH', '/sdrs/' + slot, { [field]: inp.value }); } catch (e) { console.error(e); }
    });
  });

  if (currentConnectSlot) refreshConnectModal();
}

async function toggleSlotActive(slot) {
  try {
    const res = await api('POST', '/sdrs/' + slot + '/toggle-active');
    const s = sdrsCache.find(x => x.slot === slot);
    if (s) s.ai_active = res.ai_active;
    loadSdrs();
  } catch (e) {
    alert('Erro ao alternar: ' + e.message);
  }
}

const dispatchDebounce = new Map();
async function startDispatch(slot) {
  if (dispatchDebounce.has(slot)) {
    alert('Aguarde um momento, já está processando o clique anterior...');
    return;
  }
  dispatchDebounce.set(slot, true);
  setTimeout(() => dispatchDebounce.delete(slot), 3000);
  try {
    await api('POST', '/sdrs/' + slot + '/dispatch/start');
    loadSdrs();
  } catch (e) {
    const msg = e.message.includes('sem_mensagem_disparo')
      ? 'Configure uma mensagem de disparo para este slot antes de iniciar.'
      : e.message;
    alert('Erro ao iniciar: ' + msg);
  }
}

async function resetAndStart(slot, count) {
  if (!confirm('Reiniciar o atendimento do Slot ' + slot + '?\n\nIsso vai reenviar a mensagem inicial pros ' + count + ' contato(s) que já foram disparados.')) return;
  try {
    await api('POST', '/sdrs/' + slot + '/dispatch/reset-queue');
    await api('POST', '/sdrs/' + slot + '/dispatch/start');
    loadSdrs();
  } catch (e) {
    alert('Erro ao reiniciar: ' + e.message);
  }
}

async function pauseDispatch(slot) {
  if (!confirm('Pausar o atendimento do Slot ' + slot + '? A fila continua salva e você pode retomar quando quiser.')) return;
  try {
    await api('POST', '/sdrs/' + slot + '/dispatch/pause');
    loadSdrs();
  } catch (e) {
    alert('Erro ao pausar: ' + e.message);
  }
}

/* ===== Modal Ativar SDR ===== */
let currentActivateSlot = null;

function openActivateModal(slot) {
  currentActivateSlot = slot;
  $('#activate-slot-label').textContent = '· Slot ' + slot;
  $('#modal-activate').style.display = 'flex';
}
function closeActivateModal() {
  currentActivateSlot = null;
  $('#modal-activate').style.display = 'none';
}
async function chooseActivateZeus() {
  if (currentActivateSlot == null) return;
  const slot = currentActivateSlot;
  try {
    await api('POST', '/sdrs/' + slot + '/zeus-mode', { enabled: true });
    closeActivateModal();
    await loadSdrs();
    alert('Zeus ativado no Slot ' + slot + '. Ele vai responder por esse SDR quando o gatilho bater.');
  } catch (e) {
    alert('Erro: ' + e.message);
  }
}
function chooseActivateChip() {
  const slot = currentActivateSlot;
  closeActivateModal();
  if (slot != null) openConnectModal(slot);
}
async function disableZeusMode(slot) {
  if (!confirm('Desativar o Zeus no Slot ' + slot + '?')) return;
  try {
    await api('POST', '/sdrs/' + slot + '/zeus-mode', { enabled: false });
    await loadSdrs();
  } catch (e) {
    alert('Erro: ' + e.message);
  }
}

/* ===== Modal Conectar Chip ===== */
let currentConnectSlot = null;
let currentConnectTab = 'qr';
let lastQrRendered = null;

async function openConnectModalFromZeus(slot) {
  if (!confirm('Vou desativar o Zeus deste slot e abrir o pareamento do chip por QR Code / Token. Confirma?')) return;
  try {
    await api('POST', '/sdrs/' + slot + '/zeus-mode', { enabled: false });
    await loadSdrs();
    await openConnectModal(slot);
  } catch (e) {
    alert('Erro: ' + e.message);
  }
}

async function openConnectModal(slot) {
  currentConnectSlot = slot;
  currentConnectTab = 'qr';
  lastQrRendered = null;
  $('#connect-slot-label').textContent = '· Slot ' + slot;
  const s = sdrsCache.find(x => x.slot === slot);
  $('#connect-sdr-name').textContent = s && s.name ? s.name : 'Escolha como quer parear o número.';
  switchConnectTab('qr');
  $('#pair-phone').value = '';
  $('#pair-code-display').style.display = 'none';
  $('#pair-code-loading').style.display = 'none';
  $('#modal-connect').style.display = 'flex';

  // Se ainda não conectou (ou QR está velho/sem processo vivo), dispara connect/reconnect
  if (s && s.status !== 'ready' && s.status !== 'connecting') {
    try { await api('POST', '/sdrs/' + slot + '/reconnect'); } catch {}
  }
  await refreshConnectModal();
}

function closeConnectModal() {
  currentConnectSlot = null;
  lastQrRendered = null;
  $('#modal-connect').style.display = 'none';
}

function switchConnectTab(tab) {
  currentConnectTab = tab;
  $$('#modal-connect .tab').forEach(el => el.classList.toggle('active', el.dataset.tab === tab));
  $$('#modal-connect .tab-panel').forEach(el => el.classList.remove('active'));
  $('#tab-' + tab).classList.add('active');
}

async function refreshConnectModal() {
  if (currentConnectSlot == null) return;
  try {
    const { sdr } = await api('GET', '/sdrs/' + currentConnectSlot);
    // se já conectou, fecha
    if (sdr.status === 'ready') {
      closeConnectModal();
      await loadSdrs();
      alert('Chip ' + (sdr.name || 'Slot ' + sdr.slot) + ' conectado! ' + (sdr.phone ? '+' + sdr.phone : ''));
      return;
    }
    // Se status voltou pra idle sozinho (Chrome crashou), avisa usuario que precisa clicar de novo.
    if (sdr.status === 'idle') {
      $('#qr-canvas-wrap-modal').style.display = 'none';
      $('#qr-status').style.display = 'block';
      $('#qr-status').textContent = 'Sessao caiu. Clique em "Gerar novo QR code" pra tentar de novo.';
    }
    // QR tab
    if (sdr.last_qr) {
      $('#qr-canvas-wrap-modal').style.display = 'grid';
      $('#qr-status').style.display = 'none';
      if (lastQrRendered !== sdr.last_qr) {
        lastQrRendered = sdr.last_qr;
        const imgEl = document.getElementById('qr-img-modal');
        const canvasEl = document.getElementById('qr-canvas-modal');
        if (typeof sdr.last_qr === 'string' && sdr.last_qr.startsWith('data:image')) {
          // Backend ja entregou data URL PNG pronta — usa <img>.
          imgEl.src = sdr.last_qr;
          imgEl.style.display = 'block';
          canvasEl.style.display = 'none';
        } else {
          // Fallback: string bruta do WA, renderiza client-side.
          imgEl.style.display = 'none';
          canvasEl.style.display = 'block';
          try { await QRCode.toCanvas(canvasEl, sdr.last_qr, { width: 240, margin: 1, color: { dark: '#000000', light: '#ffffff' } }); } catch (e) { console.error(e); }
        }
      }
    } else if (sdr.status !== 'idle') {
      $('#qr-canvas-wrap-modal').style.display = 'none';
      $('#qr-status').style.display = 'block';
      $('#qr-status').textContent = 'Gerando QR code, aguarde…';
    }
    // Token tab: se veio pairing_code do backend, mostra
    if (sdr.pairing_code) {
      $('#pair-code-display').style.display = 'block';
      $('#pair-code-loading').style.display = 'none';
      $('#pair-code-value').textContent = sdr.pairing_code;
    } else if ($('#pair-code-loading').style.display === 'block' && sdr.status === 'idle') {
      // Session caiu enquanto esperava codigo — para o spinner.
      $('#pair-code-loading').style.display = 'none';
      $('#pair-code-loading').textContent = 'Nao foi possivel gerar o codigo. Tente de novo.';
    }
  } catch (e) {
    console.error('refreshConnectModal', e);
  }
}

async function requestPairCode(force) {
  if (currentConnectSlot == null) return;
  const phone = $('#pair-phone').value.replace(/\D/g, '');
  if (phone.length < 10 || phone.length > 15) { alert('Numero invalido. Use DDI+DDD+numero, so digitos (ex: 5511999999999).'); return; }
  $('#pair-code-loading').style.display = 'block';
  $('#pair-code-loading').textContent = 'Gerando codigo, aguarde ate 20s…';
  $('#pair-code-display').style.display = 'none';
  lastQrRendered = null;
  try {
    const res = await api('POST', '/sdrs/' + currentConnectSlot + '/pair-code', { phone, force: !!force });
    if (res.code) {
      $('#pair-code-display').style.display = 'block';
      $('#pair-code-loading').style.display = 'none';
      $('#pair-code-value').textContent = res.code;
    }
    // Se res.code veio null (starting_session), o poll de refreshConnectModal
    // vai capturar o pairing_code do backend em poucos segundos.
  } catch (e) {
    $('#pair-code-loading').style.display = 'none';
    alert('Erro ao gerar codigo: ' + e.message);
  }
}

async function regenerateQr() {
  if (currentConnectSlot == null) return;
  lastQrRendered = null;
  $('#qr-canvas-wrap-modal').style.display = 'none';
  $('#qr-status').style.display = 'block';
  $('#qr-status').textContent = 'Reiniciando sessão e gerando novo QR code…';
  try {
    await api('POST', '/sdrs/' + currentConnectSlot + '/reconnect');
  } catch (e) {
    alert('Erro ao reiniciar sessão: ' + e.message);
  }
}

async function disconnectFromConnectModal() {
  if (currentConnectSlot == null) return;
  await disconnectSlot(currentConnectSlot);
}

async function disconnectSlot(slot) {
  const s = (sdrsCache || []).find(x => x.slot === slot) || {};
  const nome = s.name ? ' (' + s.name + ')' : '';
  const msg = 'Desconectar o WhatsApp do slot ' + slot + nome + '?\n\n'
    + 'O chip vai ser desassociado no celular do cliente (some de "Aparelhos conectados").\n'
    + 'Pra usar de novo vai precisar parear com QR ou codigo.';
  if (!confirm(msg)) return;
  try {
    await api('POST', '/sdrs/' + slot + '/disconnect');
  } catch (e) {
    alert('Erro ao desconectar: ' + (e && e.message ? e.message : e));
    return;
  }
  // Fecha modal de conectar se estiver aberto no slot desconectado.
  if (currentConnectSlot === slot) {
    currentConnectSlot = null;
    const m = document.getElementById('modal-connect');
    if (m) m.style.display = 'none';
  }
  loadSdrs();
}

