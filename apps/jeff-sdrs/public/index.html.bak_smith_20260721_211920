function toggleMediaBlock(kind) {
  const en = document.getElementById('cfg-send-' + kind + '-enabled');
  const body = document.getElementById('cfg-send-' + kind + '-body');
  if (!en || !body) return;
  body.style.display = en.checked ? 'block' : 'none';
}

async function uploadMedia(evt, kind) {
  const file = evt.target.files[0];
  if (!file || currentCfgSlot == null) return;
  const fd = new FormData();
  fd.append('file', file);
  fd.append('kind', kind);
  try {
    const r = await fetch('/api/sdrs/' + currentCfgSlot + '/media-upload', {
      method: 'POST', credentials: 'include', body: fd,
    });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error || ('HTTP ' + r.status));
    const label = document.getElementById('cfg-send-' + kind + '-name');
    if (label) label.textContent = (j.name || 'arquivo salvo') + ' (' + Math.round((j.size || 0) / 1024) + ' KB)';
  } catch (e) {
    alert('Erro ao subir ' + kind + ': ' + e.message);
  }
  evt.target.value = '';
}

async function uploadFile(evt) {
  const file = evt.target.files[0];
  if (!file || currentCfgSlot == null) return;
  const nameLower = (file.name || '').toLowerCase();
  const isXlsx = /\.(xlsx|xls)$/i.test(nameLower);
  if (isXlsx) {
    // Envia direto pro backend via multipart
    const fd = new FormData();
    fd.append('file', file);
    try {
      const r = await fetch('/api/sdrs/' + currentCfgSlot + '/upload-xlsx', {
        method: 'POST', credentials: 'include', body: fd,
      });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.error || ('HTTP ' + r.status));
      const dupPart = j.duplicated ? ' Duplicados ignorados: ' + j.duplicated + '.' : '';
      alert('Puxados: ' + j.added + ' contato(s). Ignorados: ' + j.skipped + '.' + dupPart);
      refreshUploadJobs();
    } catch (e) {
      alert('Erro ao processar xlsx: ' + e.message);
    }
    evt.target.value = '';
    return;
  }
  // CSV/TXT: mantem fluxo antigo
  const text = await file.text();
  $('#cfg-list-input').value = text;
  evt.target.value = '';
  submitContactList();
}

