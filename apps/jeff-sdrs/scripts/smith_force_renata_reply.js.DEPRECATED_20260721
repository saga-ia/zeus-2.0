'use strict';
// Smith 2026-07-21: força SDR slot 2 responder Renata AGORA.
// Problema: msg dela chegou como e2e_notification (non_text_only) e o SDR pulou.
// Estratégia:
//   1. Inserir "Olá! Tudo bem!" no banco como from_me=0, ts=agora
//   2. Chamar aiPipeline.processConversation com messages=[{body:'Olá! Tudo bem!', type:'chat'}]
//   3. sendMessage: POST /conversations/reply com JWT forjado (usa client vivo do pm2)

process.chdir('/opt/jeff-apps/jeff-sdrs');
require('/opt/jeff-apps/jeff-sdrs/node_modules/dotenv').config({ path: '/opt/jeff-apps/jeff-sdrs/.env' });

const { db } = require('/opt/jeff-apps/jeff-sdrs/src/db');
const aiPipeline = require('/opt/jeff-apps/jeff-sdrs/src/services/aiPipeline');
const jwt = require('/opt/jeff-apps/jeff-sdrs/node_modules/jsonwebtoken');
const http = require('http');

const SLOT = 2;
const CHAT_ID = '169269107097829@lid';
const INCOMING_BODY = 'Olá! Tudo bem!';
const JWT_SECRET = process.env.JWT_SECRET || 'dev-secret-change-me';

// Forja token pro user jeff (id=1, admin)
const user = db.prepare('SELECT id, username, role FROM users WHERE id = 1').get();
if (!user) { console.error('user id=1 nao existe'); process.exit(1); }
const token = jwt.sign({ uid: user.id, u: user.username, r: user.role }, JWT_SECRET, { expiresIn: '30d' });

// 1) Salvar msg da Renata no banco (só se ainda não tem essa msg exata em ts recente)
const now = Math.floor(Date.now() / 1000);
const existing = db.prepare(
  `SELECT id FROM messages WHERE slot=? AND chat_id=? AND body=? AND ts >= ? LIMIT 1`
).get(SLOT, CHAT_ID, INCOMING_BODY, now - 3600);
if (existing) {
  console.log(`[smith] msg ja existia id=${existing.id}, skip insert`);
} else {
  const waId = `smith_inject_${now}`;
  const info = db.prepare(
    `INSERT INTO messages (slot, chat_id, wa_message_id, from_me, body, ts, type, created_at)
     VALUES (?, ?, ?, 0, ?, ?, 'chat', datetime('now'))`
  ).run(SLOT, CHAT_ID, waId, INCOMING_BODY, now);
  console.log(`[smith] msg inserida id=${info.lastInsertRowid} ts=${now}`);
}

// 2) sendMessage via POST /conversations/reply
function sendViaHttp(chatId, text) {
  return new Promise((resolve, reject) => {
    const payload = JSON.stringify({ slot: SLOT, chat_id: chatId, body: text });
    const req = http.request({
      host: '127.0.0.1',
      port: 3041,
      path: '/api/conversations/reply',
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(payload),
        'Cookie': `disp_session=${token}`,
      },
    }, (res) => {
      let data = '';
      res.on('data', (c) => data += c);
      res.on('end', () => {
        if (res.statusCode >= 200 && res.statusCode < 300) resolve(data);
        else reject(new Error(`HTTP ${res.statusCode}: ${data}`));
      });
    });
    req.on('error', reject);
    req.write(payload);
    req.end();
  });
}

// 3) Chamar processConversation
const fakeIncoming = [{ body: INCOMING_BODY, type: 'chat', hasMedia: false }];

(async () => {
  console.log(`[smith] chamando processConversation(slot=${SLOT}, chatId=${CHAT_ID})`);
  const result = await aiPipeline.processConversation(SLOT, CHAT_ID, fakeIncoming, {
    sendMessage: async (cid, text) => {
      console.log(`[smith] IA gerou resposta (${text.length} chars): ${text.substr(0, 200)}...`);
      const r = await sendViaHttp(cid, text);
      console.log(`[smith] enviado via /conversations/reply: ${r}`);
    },
  });
  console.log('[smith] RESULT:', JSON.stringify(result, null, 2));
  process.exit(0);
})().catch((e) => {
  console.error('[smith] ERRO:', e && e.stack || e);
  process.exit(1);
});
